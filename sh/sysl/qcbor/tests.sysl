module sh.sysl.qcbor

import sh.sysl.qcbor.c
import sysl.text.{str_builder_with_capacity, from_utf8}

// The binding's own tests, run by `sysl test .`.
//
// **Almost every expected byte string below is from RFC 8949 appendix A**, which prints a table of
// CBOR encodings beside the diagnostic notation for what each one means. So a test that passes says
// the bytes crossed the boundary intact and came back as the specification says they should, and a
// binding that swapped two arguments or dropped a length could not make one pass by coincidence.
//
// That is worth more here than a round-trip would be on its own: encoding and decoding through the
// same wrong assumption round-trips perfectly.

private nib(c: u8) -> u8 = if c >= 97 then c - 87 elif c >= 65 then c - 55 else c - 48

// The inverse of `hex`, for writing a vector the way the specification prints it.
private unhex(s: string) -> []u8
    require s.bytes.len % 2 == 0, "a hexadecimal byte string has an even number of digits"

    val b = s.bytes
    var out: []u8 = [0; b.len / 2]

    for i in 0..<out.len do out[i] = nib(b[i * 2]) * 16 + nib(b[i * 2 + 1])

    out
end unhex

private hex_digit(v: u8) -> char = if v < 10 then char(48 + u32(v)) else char(87 + u32(v))

private hex(bytes: []const u8) -> string
    var b = str_builder_with_capacity(bytes.len * 2)

    for x in bytes
        b.push_char(hex_digit(x >> 4))
        b.push_char(hex_digit(x & 15))

    b.finish()
end hex

// Finish an encoder and render what it wrote, so a failure shows up as a string that will not match
// rather than as a `Result` every assertion would have to unwrap.
private done(e: Encoder, out: []u8) -> string
    e.finish() match
        Err(why) -> s"<error: ${why.message()}>"
        Ok(n) -> hex(out[0..<n])
end done

// Encode one item with `build` and render it. **The closure is the expression form on purpose**: an
// indented block does not reach inside an argument list (`00 §9`), so a case needing several calls
// binds its closure to a name first, and the structural tests below do exactly that.
private check(expected: string, note: string, build: Encoder -> unit)
    var out: []u8 = [0; 128]
    var e = encoder(out)

    build(e)
    assert(done(e, out) == expected, note)
end check

// ==================================================================================================
// The shape of the binding, as against what it encodes
// ==================================================================================================

// **The encoder must survive the function that made it.** A QCBOR context is storage the caller
// supplies and the encoder holds a pointer into it, so an encoder whose storage was a local of a
// function that has returned would write through a dangling pointer -- and would very likely still
// pass a test that built and used it in one place. This builds it somewhere else on purpose.
private make_one(out: []u8) -> Encoder
    var e = encoder(out)

    e.open_array()
    e
end make_one

@test
an_encoder_outlives_the_function_that_made_it() =
    var out: []u8 = [0; 32]
    var e = make_one(out)

    e.add_int(1)
    e.add_int(2)
    e.close_array()

    assert(done(e, out) == "820102", "[1, 2] survives its constructor")

// The storage a caller supplies is the allocator-free path, and it must reach the same bytes.
//
// **`[encode_words]u64` is a fixed-size array in this frame rather than a slice off the heap** --
// which is the whole reason that size is a `c const` and not a shim function. An array's length has
// to be a constant, so while `encode_words` was something to *call*, a program with no allocator
// could only transcribe a number that was right on one machine. This is the shape an embedded caller
// writes, and nothing else here would notice if it stopped compiling.
@test
an_encoder_can_be_given_its_own_storage() =
    var storage: [encode_words]u64 = [0; encode_words]
    var out: [32]u8 = [0; 32]

    encoder_with_storage(storage[0..<encode_words], out[0..<32]) match
        Err(why) -> assert(false, why)
        Ok(e) ->
            e.add_int(1)
            assert(done(e, out[0..<32]) == "01", "1")

// The same size reached the other way: **module-qualified**, straight off `sh.sysl.qcbor.c` rather
// than through this module's re-export.
//
// That was refused until sysl 0.0.48 -- card 0104, and the reason every constant here is named
// twice. The two-layer naming stays because it is what `15 §7` asks for, so nothing else in the
// package writes the qualified form and nothing else would notice it being refused again.
@test
a_qualified_c_const_is_a_constant_expression() =
    var storage: [c.ENCODE_CONTEXT_WORDS]u64 = [0; c.ENCODE_CONTEXT_WORDS]

    assert_eq(storage.len, encode_words, "the same array either way it is spelled")

// The same for the decoder, whose storage holds QCBOR's context and the item slot together. Its size
// is `sizeof` a structure declared in `shim.h`, and that header exists for no other reason: a `c
// const` is compiled outside the shim, so it has to be able to name what it measures.
@test
a_decoder_can_be_given_its_own_storage() =
    var storage: [decoder_words]u64 = [0; decoder_words]

    assert(decoder_words > encode_words, "a decoder carries an item slot as well as the context")

    decoder_with_storage(storage[0..<decoder_words], unhex("83010203"), Normal) match
        Err(why) -> assert(false, why)
        Ok(d) ->
            var head = d.next().unwrap()

            assert(head.kind() == Array, "an array")
            assert(is_count(head, 3), "of three members")

// Storage shorter than the context needs is refused rather than written past.
@test
storage_that_is_too_small_is_refused() =
    var storage: []u64 = [0; 1]
    var out: []u8 = [0; 32]

    encoder_with_storage(storage, out) match
        Ok(_) -> assert(false, "one word is not enough for a context and should have been refused")
        Err(_) -> assert(true, "refused")

// ==================================================================================================
// Encoding — RFC 8949 appendix A
// ==================================================================================================

@test
encodes_the_unsigned_integers() =
    check("00", "0", e -> e.add_int(0))
    check("01", "1", e -> e.add_int(1))
    check("0a", "10", e -> e.add_int(10))
    check("17", "23", e -> e.add_int(23))
    check("1818", "24", e -> e.add_int(24))
    check("1819", "25", e -> e.add_int(25))
    check("1864", "100", e -> e.add_int(100))
    check("1903e8", "1000", e -> e.add_int(1000))
    check("1a000f4240", "1000000", e -> e.add_int(1000000))
    check("1b000000e8d4a51000", "1000000000000", e -> e.add_int(1000000000000))

// The largest CBOR unsigned integer is 2^64 - 1, which does not fit a signed `long`. That is the
// reason `add_uint` is a method of its own rather than `add_int` taking the wider type.
@test
encodes_the_largest_unsigned_integer() =
    check("1bffffffffffffffff", "18446744073709551615", e -> e.add_uint(18446744073709551615))

@test
encodes_the_negative_integers() =
    check("20", "-1", e -> e.add_int(-1))
    check("29", "-10", e -> e.add_int(-10))
    check("3863", "-100", e -> e.add_int(-100))
    check("3903e7", "-1000", e -> e.add_int(-1000))

@test
encodes_the_simple_values() =
    check("f4", "false", e -> e.add_bool(false))
    check("f5", "true", e -> e.add_bool(true))
    check("f6", "null", e -> e.add_null())
    check("f7", "undefined", e -> e.add_undef())
    check("f0", "simple(16)", e -> e.add_simple(16))
    check("f8ff", "simple(255)", e -> e.add_simple(255))

// **Preferred serialization is what makes these two bytes.** A double whose value fits a half
// exactly is written as a half, which is RFC 8949's rule and what a protocol needing deterministic
// bytes depends on.
@test
encodes_floats_in_their_shortest_exact_form() =
    check("f90000", "0.0", e -> e.add_double(0.0))
    check("f98000", "-0.0", e -> e.add_double(-0.0))
    check("f93c00", "1.0", e -> e.add_double(1.0))
    check("f93e00", "1.5", e -> e.add_double(1.5))
    check("f97bff", "65504.0", e -> e.add_double(65504.0))
    check("f9c400", "-4.0", e -> e.add_double(-4.0))
    check("fb3ff199999999999a", "1.1", e -> e.add_double(1.1))
    check("fbc010666666666666", "-4.1", e -> e.add_double(-4.1))
    check("fa47c35000", "100000.0", e -> e.add_double(100000.0))
    check("fb7e37e43c8800759c", "1.0e+300", e -> e.add_double(1.0e+300))

// The smallest subnormal and the smallest normal half, which are the edges of the shortening rule.
@test
encodes_the_small_halves() =
    check("f90001", "5.960464477539063e-8", e -> e.add_double(5.960464477539063e-8))
    check("f90400", "0.00006103515625", e -> e.add_double(0.00006103515625))

// Without preferred serialization the same value takes its full width, which is what a protocol that
// fixes the encoding wants.
@test
encodes_floats_at_full_width_when_asked() =
    check("fb3ff0000000000000", "1.0 as a double", e -> e.add_double_exact(1.0))
    check("fa3f800000", "1.0 as a float", e -> e.add_float_exact(1.0))

@test
encodes_the_text_strings() =
    check("60", "the empty string", e -> e.add_text(""))
    check("6161", "a", e -> e.add_text("a"))
    check("6449455446", "IETF", e -> e.add_text("IETF"))
    check("62225c", "a quote and a backslash", e -> e.add_text("\"\\"))
    check("62c3bc", "u with an umlaut", e -> e.add_text("ü"))
    check("63e6b0b4", "the character for water", e -> e.add_text("水"))

@test
encodes_the_byte_strings() =
    check("40", "the empty byte string", e -> e.add_bytes([]))
    check("4401020304", "four bytes", e -> e.add_bytes(unhex("01020304")))

@test
encodes_the_arrays() =
    var empty = (e: Encoder) ->
        e.open_array()
        e.close_array()

    var three = (e: Encoder) ->
        e.open_array()
        e.add_int(1)
        e.add_int(2)
        e.add_int(3)
        e.close_array()

    var nested = (e: Encoder) ->
        e.open_array()
        e.add_int(1)
        e.open_array()
        e.add_int(2)
        e.add_int(3)
        e.close_array()
        e.open_array()
        e.add_int(4)
        e.add_int(5)
        e.close_array()
        e.close_array()

    check("80", "[]", empty)
    check("83010203", "[1, 2, 3]", three)
    check("8301820203820405", "[1, [2, 3], [4, 5]]", nested)

@test
encodes_the_maps() =
    var empty = (e: Encoder) ->
        e.open_map()
        e.close_map()

    // Integer labels, which is what a compact protocol uses in place of names.
    var numbered = (e: Encoder) ->
        e.open_map()
        e.label_at(1)
        e.add_int(2)
        e.label_at(3)
        e.add_int(4)
        e.close_map()

    var with_array = (e: Encoder) ->
        e.open_map()
        e.label("a")
        e.add_int(1)
        e.label("b")
        e.open_array()
        e.add_int(2)
        e.add_int(3)
        e.close_array()
        e.close_map()

    var map_in_array = (e: Encoder) ->
        e.open_array()
        e.add_text("a")
        e.open_map()
        e.label("b")
        e.add_text("c")
        e.close_map()
        e.close_array()

    check("a0", "{}", empty)
    check("a201020304", "{1: 2, 3: 4}", numbered)
    check("a26161016162820203", "{\"a\": 1, \"b\": [2, 3]}", with_array)
    check("826161a161626163", "[\"a\", {\"b\": \"c\"}]", map_in_array)

// The indefinite-length forms write a break byte instead of a count. RFC 8949 prints these with an
// underscore in the diagnostic notation.
@test
encodes_the_indefinite_length_forms() =
    var empty = (e: Encoder) ->
        e.open_array_indefinite()
        e.close_array_indefinite()

    var mixed = (e: Encoder) ->
        e.open_array_indefinite()
        e.add_int(1)
        e.open_array()
        e.add_int(2)
        e.add_int(3)
        e.close_array()
        e.open_array_indefinite()
        e.add_int(4)
        e.add_int(5)
        e.close_array_indefinite()
        e.close_array_indefinite()

    var map = (e: Encoder) ->
        e.open_map_indefinite()
        e.label("a")
        e.add_int(1)
        e.label("b")
        e.open_array_indefinite()
        e.add_int(2)
        e.add_int(3)
        e.close_array_indefinite()
        e.close_map_indefinite()

    check("9fff", "[_ ]", empty)
    check("9f018202039f0405ffff", "[_ 1, [2, 3], [_ 4, 5]]", mixed)
    check("bf61610161629f0203ffff", "{_ \"a\": 1, \"b\": [_ 2, 3]}", map)

// ==================================================================================================
// Tags
// ==================================================================================================

@test
encodes_the_tagged_types_from_the_specification() =
    var b16 = (e: Encoder) ->
        e.add_tag(tag_enc_as_b16)
        e.add_bytes(unhex("01020304"))

    var nested_cbor = (e: Encoder) ->
        e.add_tag(tag_cbor)
        e.add_bytes(unhex("6449455446"))

    check("c074323031332d30332d32315432303a30343a30305a", "0(\"2013-03-21T20:04:00Z\")",
          e -> e.add_date_string("2013-03-21T20:04:00Z", true))
    check("c11a514b67b0", "1(1363896240)", e -> e.add_date_epoch(1363896240, true))
    check("d74401020304", "23(h'01020304')", b16)
    check("d818456449455446", "24(h'6449455446')", nested_cbor)
    check("d82076687474703a2f2f7777772e6578616d706c652e636f6d", "32(\"http://www.example.com\")",
          e -> e.add_uri("http://www.example.com", true))

// 2^64, which is one more than the largest CBOR unsigned integer and therefore has to be a bignum.
// RFC 8949 prints it as 2(h'010000000000000000').
@test
encodes_a_positive_bignum() =
    check("c249010000000000000000", "18446744073709551616",
          e -> e.add_positive_bignum(unhex("010000000000000000"), true))

// **A negative bignum does not carry the magnitude.** Tag 3's content encodes -1 minus the value, so
// -18446744073709551617 is h'010000000000000000' -- the same bytes as the positive case above under
// a different tag, which is exactly the trap this test exists to pin.
@test
encodes_a_negative_bignum() =
    check("c349010000000000000000", "-18446744073709551617",
          e -> e.add_negative_bignum(unhex("010000000000000000"), true))

// Tag 4 is [exponent, mantissa] and the value is mantissa times ten to the exponent. RFC 8949's
// example is 4([-2, 27315]), which is 273.15.
@test
encodes_a_decimal_fraction() =
    check("c48221196ab3", "4([-2, 27315])", e -> e.add_decimal_fraction(27315, -2, true))

// Tag 5 is the same with a base of two. RFC 8949's example is 5([-1, 3]), which is 1.5.
@test
encodes_a_big_float() =
    check("c5822003", "5([-1, 3])", e -> e.add_big_float(3, -1, true))

// **A tag number is written only when asked for.** The borrowed form writes the content alone, for a
// protocol whose schema already says what the item is -- and that content is byte-identical to what
// the tagged form wraps, which is what this pair shows.
@test
a_borrowed_tag_writes_the_content_alone() =
    check("c11a514b67b0", "tagged", e -> e.add_date_epoch(1363896240, true))
    check("1a514b67b0", "borrowed", e -> e.add_date_epoch(1363896240, false))

// The tag numbers are read from QCBOR's headers rather than written here, so this pins the ones the
// specification and the CBOR registry fix.
@test
the_registered_tag_numbers_are_what_the_registry_says() =
    assert(tag_date_string == 0, "tag 0 is an RFC 3339 date string")
    assert(tag_date_epoch == 1, "tag 1 is an epoch date")
    assert(tag_pos_bignum == 2, "tag 2 is a positive bignum")
    assert(tag_neg_bignum == 3, "tag 3 is a negative bignum")
    assert(tag_decimal_fraction == 4, "tag 4 is a decimal fraction")
    assert(tag_bigfloat == 5, "tag 5 is a big float")
    assert(tag_enc_as_b64url == 21, "tag 21 is expected-base64url")
    assert(tag_enc_as_b64 == 22, "tag 22 is expected-base64")
    assert(tag_enc_as_b16 == 23, "tag 23 is expected-base16")
    assert(tag_cbor == 24, "tag 24 is encoded CBOR")
    assert(tag_uri == 32, "tag 32 is a URI")
    assert(tag_b64url == 33, "tag 33 is base64url")
    assert(tag_b64 == 34, "tag 34 is base64")
    assert(tag_regex == 35, "tag 35 is a regular expression")
    assert(tag_mime == 36, "tag 36 is a MIME message")
    assert(tag_bin_uuid == 37, "tag 37 is a binary UUID")
    assert(tag_days_epoch == 100, "tag 100 is an epoch day count")
    assert(tag_days_string == 1004, "tag 1004 is a full-date string")
    assert(tag_cbor_magic == 55799, "tag 55799 is the self-describing prefix")

// ==================================================================================================
// Errors
// ==================================================================================================

// A buffer too small for what is being written is the ordinary encoding failure, and it arrives at
// `finish` rather than at the call that overran -- which is QCBOR's design and the reason none of the
// `add` methods report anything.
@test
a_buffer_too_small_is_reported_once_at_the_end() =
    var out: []u8 = [0; 2]
    var e = encoder(out)

    e.add_text("more than two bytes")

    e.finish() match
        Ok(_) -> assert(false, "nineteen bytes should not fit in two")
        Err(why) ->
            assert(why.kind() == BufferTooSmall, "the buffer was too small")
            assert(why.message() != "", "QCBOR supplies its own sentence for it")

// An unclosed map is caught at `finish` rather than left to produce truncated CBOR.
@test
an_unclosed_map_is_caught() =
    var out: []u8 = [0; 32]
    var e = encoder(out)

    e.open_map()
    e.label("a")
    e.add_int(1)

    e.finish() match
        Ok(_) -> assert(false, "a map left open should not finish")
        Err(why) -> assert(why.kind() == ArrayOrMapStillOpen, "the map is still open")

// **A label with no value is NOT caught, and this test exists to pin exactly that.**
//
// A map's entries are pairs, so an odd count has no meaning -- but QCBOR does not check. It writes
// half the item count, rounded down, as the entry count: one item becomes `a0`, an *empty* map, and
// the orphaned label is left after it as a second top-level data item. `finish` reports success.
//
// The test asserts the wrong-looking bytes on purpose. It is not endorsing them -- it is so that if
// a later QCBOR starts rejecting this, or the binding ever grows a check of its own, the change is
// noticed here rather than by whoever is reading the output at the far end.
@test
a_dangling_label_is_not_caught() =
    var out: []u8 = [0; 32]
    var e = encoder(out)

    e.open_map()
    e.label("a")
    e.close_map()

    assert(done(e, out) == "a06161",
           "an empty map followed by the orphaned label, and no error at all")

// ==================================================================================================
// Sizing, position, and the pieces for assembling CBOR by hand
// ==================================================================================================

// **An encoder given no buffer counts bytes instead of writing them**, which is how a caller sizes a
// buffer before making one. The count must agree with what the same calls actually write.
@test
an_encoder_with_no_buffer_counts_what_it_would_write() =
    var nothing: []u8 = []
    var counter = encoder(nothing)

    assert(counter.counting_only(), "an empty buffer is size-calculation mode")

    counter.open_array()
    counter.add_int(1)
    counter.add_text("IETF")
    counter.close_array()

    counter.finish_get_size() match
        Err(why) -> assert(false, why.message())
        Ok(size) ->
            var out: []u8 = [0; 64]
            var e = encoder(out)

            e.open_array()
            e.add_int(1)
            e.add_text("IETF")
            e.close_array()

            assert(done(e, out).bytes.len / 2 == size, "the counted size is what gets written")

// `tell` and `substring` are a pair: note a position, encode, then ask what those items came to.
//
// Marked and read at the same nesting level with no close in between, which is the shape that is
// safe. A CBOR sequence -- several top-level items in a row -- is what this is for.
@test
substring_reports_what_was_written_since_a_position() =
    var out: []u8 = [0; 64]
    var e = encoder(out)

    e.add_int(7)

    val start = e.tell()

    e.add_int(1)
    e.add_text("IETF")

    val span = e.substring(start)

    // Finished once and held, because `finish` is not idempotent -- calling it twice is how an
    // earlier draft of this test managed to fail against a correct binding.
    val encoded = done(e, out)

    assert(encoded == "07016449455446", "7, 1, \"IETF\" as a sequence")
    assert(hex(out[span.offset..<span.offset + span.len]) == "016449455446",
           "the two items written since the mark, and not the one before it")

// **A span taken while an array was open is stale once the array closes**, because the array's head
// is inserted at the position the open happened and shifts everything after it. QCBOR cannot detect
// this and neither can the binding, so it is written down here as the behaviour a caller must design
// around rather than left to be discovered.
@test
a_span_does_not_survive_the_close_of_an_enclosing_array() =
    var out: []u8 = [0; 64]
    var e = encoder(out)

    e.open_array()

    val start = e.tell()

    e.add_int(1)
    e.add_text("IETF")

    val span = e.substring(start)

    e.close_array()

    assert(done(e, out) == "82016449455446", "[1, \"IETF\"]")

    // `tell` answered 0, because the head is not written yet; after the close, offset 0 is the head.
    assert(span.offset == 0, "the mark was taken before the head existed")
    assert(hex(out[span.offset..<span.offset + span.len]) == "820164494554",
           "so the span is off by the one byte the head took")

// A byte string whose content is written straight into the output buffer, with no second copy.
@test
open_bytes_writes_into_the_output_buffer() =
    var out: []u8 = [0; 64]
    var e = encoder(out)

    e.open_bytes() match
        None -> assert(false, "there should be room")
        Some(place) ->
            place[0] = 1
            place[1] = 2
            place[2] = 3
            e.close_bytes(3)

    assert(done(e, out) == "43010203", "h'010203'")

// A byte string whose content is itself CBOR -- how COSE carries a payload whose exact bytes are
// signed. The span is what a caller would hash.
@test
bstr_wrap_reports_where_the_wrapped_bytes_are() =
    var out: []u8 = [0; 64]
    var e = encoder(out)

    e.bstr_wrap()
    e.add_int(1)
    e.add_int(2)

    val span = e.close_bstr_wrap(false)
    val encoded = done(e, out)

    // Two one-byte items inside a byte string of length two: 42 is the head.
    assert(encoded == "420102", "a byte string holding 01 02")
    assert(hex(out[span.offset..<span.offset + span.len]) == "0102",
           "the span names the content without its head")

// Already-encoded CBOR spliced in as-is, which is what a cache of pre-encoded fragments needs.
@test
encoded_bytes_are_spliced_in_unchanged() =
    var build = (e: Encoder) ->
        e.open_array()
        e.add_int(1)
        e.add_encoded(unhex("02"))
        e.add_encoded(unhex("03"))
        e.close_array()

    check("83010203", "[1, 2, 3] built from fragments", build)

// The head of a data item on its own, for a caller assembling CBOR around this binding rather than
// through it.
@test
a_head_can_be_encoded_on_its_own() =
    var out: []u8 = [0; 16]

    assert(head_max >= 9, "a head is at most nine or ten bytes")

    // Major type 0 is an unsigned integer; a minimum length of 0 lets QCBOR pick the shortest form.
    encode_head(out, 0, 0, 1000000) match
        None -> assert(false, "there should be room")
        Some(n) -> assert(hex(out[0..<n]) == "1a000f4240", "the head of 1000000")

    // Major type 2 is a byte string, and 4 is its length.
    encode_head(out, 2, 0, 4) match
        None -> assert(false, "there should be room")
        Some(n) -> assert(hex(out[0..<n]) == "44", "the head of a four-byte byte string")

// ==================================================================================================
// Decoding — the same RFC 8949 vectors, read the other way
// ==================================================================================================

// **An `Option` carries no `==`, whatever it holds** (`14`, recorded there as a catalog omission
// rather than a language gap: `impl[T: Eq] Eq for Option[T]` is writable, and the open question is
// whether the whole generic family joins the catalog at once). So a test that wants "this item holds
// this value" takes the option apart, and these say it once each instead of at every assertion.

private is_int(item: Item, want: long) -> bool =
    item.int_value() match
        None -> false
        Some(v) -> v == want

private is_uint(item: Item, want: ulong) -> bool =
    item.uint_value() match
        None -> false
        Some(v) -> v == want

private is_double(item: Item, want: real) -> bool =
    item.double_value() match
        None -> false
        Some(v) -> v == want

private is_bool(item: Item, want: bool) -> bool =
    item.bool_value() match
        None -> false
        Some(v) -> v == want

private is_simple(item: Item, want: u8) -> bool =
    item.simple_value() match
        None -> false
        Some(v) -> v == want

private is_text(item: Item, want: string) -> bool =
    item.text() match
        None -> false
        Some(r) ->
            r match
                Err(_) -> false
                Ok(s) -> s == want

private is_label(item: Item, want: string) -> bool =
    item.label() match
        None -> false
        Some(r) ->
            r match
                Err(_) -> false
                Ok(s) -> s == want

private is_label_int(item: Item, want: long) -> bool =
    item.label_int() match
        None -> false
        Some(v) -> v == want

private is_count(item: Item, want: usize) -> bool =
    item.count() match
        None -> false
        Some(v) -> v == want

private has_count(item: Item) -> bool =
    item.count() match
        None -> false
        Some(_) -> true

private has_int(item: Item) -> bool =
    item.int_value() match
        None -> false
        Some(_) -> true

// An optional byte string as hexadecimal, so an assertion compares one thing rather than unwrapping.
private hex_or_empty(b: Option[[]const u8]) -> string =
    b match
        None -> ""
        Some(v) -> hex(v)

private finished(d: Decoder) -> bool =
    d.finish() match
        Ok(_) -> true
        Err(_) -> false

// Decode the one item `cbor` holds, so a test can ask whatever it likes about it.
private only(cbor: string) -> Item
    var d = decoder(unhex(cbor), Normal)

    d.next() match
        Err(why) -> panic(s"decoding $cbor: ${why.message()}")
        Ok(item) -> item
end only

@test
decodes_the_integers() =
    assert(is_int(only("00"), 0), "0")
    assert(is_int(only("17"), 23), "23")
    assert(is_int(only("1818"), 24), "24")
    assert(is_int(only("1903e8"), 1000), "1000")
    assert(is_int(only("1a000f4240"), 1000000), "1000000")
    assert(is_int(only("1b000000e8d4a51000"), 1000000000000), "1000000000000")
    assert(is_int(only("20"), -1), "-1")
    assert(is_int(only("3863"), -100), "-100")
    assert(is_int(only("3903e7"), -1000), "-1000")

// **The largest CBOR unsigned integer does not fit a signed 64-bit value**, so QCBOR reports it as
// `Uint` rather than `Int` and `int_value` declines. That split is the whole reason the two
// accessors exist, and this is what pins it.
@test
the_largest_unsigned_integer_decodes_as_a_uint() =
    val item = only("1bffffffffffffffff")

    assert(item.kind() == Uint, "too large for a signed long")
    assert(!has_int(item), "so the signed accessor declines")
    assert(is_uint(item, 18446744073709551615), "18446744073709551615")

@test
decodes_the_floats() =
    assert(is_double(only("f93c00"), 1.0), "1.0 from a half")
    assert(is_double(only("f93e00"), 1.5), "1.5 from a half")
    assert(is_double(only("fb3ff199999999999a"), 1.1), "1.1 from a double")
    assert(is_double(only("fa47c35000"), 100000.0), "100000.0 from a single")

// Half and single precision both widen to a double on the way in, which is QCBOR's preferred-float
// behaviour and the reason `Float` is rare rather than impossible.
@test
narrow_floats_arrive_as_doubles() =
    assert(only("f93c00").kind() == Double, "a half decodes as a double")
    assert(only("fa47c35000").kind() == Double, "a single decodes as a double")

@test
decodes_the_simple_values() =
    assert(is_bool(only("f4"), false), "false")
    assert(is_bool(only("f5"), true), "true")
    assert(only("f6").kind() == Null, "null")
    assert(only("f7").kind() == Undef, "undefined")
    assert(is_simple(only("f0"), 16), "simple(16)")
    assert(is_simple(only("f8ff"), 255), "simple(255)")

@test
decodes_the_text_strings() =
    val ietf = only("6449455446")

    assert(ietf.kind() == TextString, "a text string")
    assert(is_text(ietf, "IETF"), "IETF")
    assert(is_text(only("60"), ""), "the empty string")
    assert(is_text(only("62c3bc"), "ü"), "u with an umlaut")
    assert(is_text(only("63e6b0b4"), "水"), "the character for water")

@test
decodes_the_byte_strings() =
    val four = only("4401020304")

    assert(four.kind() == ByteString, "a byte string")
    assert(hex_or_empty(four.bytes()) == "01020304", "four bytes")
    assert(only("40").kind() == ByteString, "the empty byte string is still a byte string")

// **A decoded string is a view into the input, not a copy.** That is what makes decoding
// allocator-free, and it is the property a caller has to know about: the slice dies with the input.
// Writing through the input and reading the slice back is the only way to show it rather than say it.
@test
a_decoded_string_views_the_input() =
    var input = unhex("6449455446")
    var d = decoder(input, Normal)

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(item) ->
            item.bytes() match
                None -> assert(false, "there are bytes")
                Some(b) ->
                    assert(hex(b) == "49455446", "the four bytes of IETF")

                    input[1] = 0x4au8

                    assert(hex(b) == "4a455446", "the slice is the input, not a copy of it")

// `text`, by contrast, is the one accessor that copies -- which is what makes it safe to keep.
@test
text_copies_where_bytes_does_not() =
    var input = unhex("6449455446")
    var d = decoder(input, Normal)

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(item) ->
            item.text() match
                None -> assert(false, "there is text")
                Some(r) ->
                    r match
                        Err(_) -> assert(false, "IETF is valid UTF-8")
                        Ok(s) ->
                            input[1] = 0x4au8

                            assert(s == "IETF", "the string was copied out before the input moved")

// ==================================================================================================
// Structure
// ==================================================================================================

@test
decodes_an_array_head_and_its_members() =
    var d = decoder(unhex("83010203"), Normal)

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(head) ->
            assert(head.kind() == Array, "an array")
            assert(is_count(head, 3), "of three members")

    // The members follow as ordinary items, one nesting level deeper.
    var seen = 0

    while seen < 3
        d.next() match
            Err(why) -> assert(false, why.message())
            Ok(item) ->
                assert(is_int(item, long(seen + 1)), "the members in order")
                assert(item.nesting() == 1, "one level in")
                seen = seen + 1

    assert(finished(d), "and the input is exhausted")

@test
decodes_a_map_with_its_labels() =
    // {"a": 1, "b": [2, 3]}
    var d = decoder(unhex("a26161016162820203"), Normal)

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(head) ->
            assert(head.kind() == Map, "a map")
            assert(is_count(head, 2), "of two entries")

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(first) ->
            assert(is_label(first, "a"), "labelled a")
            assert(is_int(first, 1), "with the value 1")

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(second) ->
            assert(is_label(second, "b"), "labelled b")
            assert(second.kind() == Array, "whose value is an array")

// An integer label is what a compact protocol uses, and it arrives through a different accessor.
@test
decodes_integer_labels() =
    // {1: 2, 3: 4}
    var d = decoder(unhex("a201020304"), Normal)

    d.next()

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(entry) ->
            assert(is_label_int(entry, 1), "the label 1")
            assert(is_int(entry, 2), "the value 2")

// **An indefinite-length array reports no count**, so a reader watches the nesting level instead --
// which is the one loop shape that works for both kinds of array.
@test
an_indefinite_array_has_no_count_and_ends_by_nesting() =
    // [_ 1, 2]
    var d = decoder(unhex("9f0102ff"), Normal)

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(head) ->
            assert(head.kind() == Array, "an array")
            assert(!has_count(head), "with no count to report")

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(first) -> assert(first.next_nesting() == 1, "another member follows at this level")

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(last) ->
            assert(is_int(last, 2), "the last member")
            assert(last.next_nesting() == 0, "and the level closed after it")

// Skipping a subtree whose content does not matter, in one call rather than by counting members.
@test
next_consume_skips_a_whole_subtree() =
    // [[1, 2, 3], 9]
    var d = decoder(unhex("828301020309"), Normal)

    d.next()
    d.next_consume()

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(after) -> assert(is_int(after, 9), "the item after the skipped array")

// Peeking does not advance, so the same item arrives again.
@test
peek_does_not_consume() =
    var d = decoder(unhex("83010203"), Normal)

    d.next()

    d.peek() match
        Err(why) -> assert(false, why.message())
        Ok(peeked) -> assert(is_int(peeked, 1), "the next member, unconsumed")

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(item) -> assert(is_int(item, 1), "and it is still there")

// ==================================================================================================
// Spiffy decode — entering a map and asking for values by label
// ==================================================================================================

private text_of(r: Result[[]const u8, Error], fallback: string) -> string =
    r match
        Err(_) -> fallback
        Ok(b) ->
            from_utf8(b) match
                Err(_) -> fallback
                Ok(s) -> s

private int_of(r: Result[long, Error], fallback: long) -> long =
    r match
        Err(_) -> fallback
        Ok(v) -> v

private double_of(r: Result[real, Error], fallback: real) -> real =
    r match
        Err(_) -> fallback
        Ok(v) -> v

private failed(r: Result[long, Error]) -> bool =
    r match
        Err(_) -> true
        Ok(_) -> false

private failed_unit(r: Result[unit, Error]) -> bool =
    r match
        Err(_) -> true
        Ok(_) -> false

private failed_bytes(r: Result[[]const u8, Error]) -> bool =
    r match
        Err(_) -> true
        Ok(_) -> false

private failed_double(r: Result[real, Error]) -> bool =
    r match
        Err(_) -> true
        Ok(_) -> false

private why(r: Result[long, Error]) -> ErrorKind =
    r match
        Err(e) -> e.kind()
        Ok(_) -> Success

// {"a": 1, "b": "IETF", "c": true}
// a3          map of three
//   6161 01     "a": 1
//   6162 6449455446   "b": "IETF"
//   6163 f5     "c": true
private sample() -> []u8 = unhex("a3616101616264494554466163f5")

@test
reads_a_map_by_label() =
    var d = decoder(sample(), Normal)

    d.enter_map()

    assert(int_of(d.get_int_in_map("a"), -1) == 1, "a is 1")
    assert(text_of(d.get_text_bytes_in_map("b"), "") == "IETF", "b is IETF")

    d.get_bool_in_map("c") match
        Err(e) -> assert(false, e.message())
        Ok(v) -> assert(v, "c is true")

    d.exit_map()

    assert(finished(d), "and the map was the whole input")

// **Order does not matter**, which is the point of searching by label rather than walking in order.
@test
labels_may_be_asked_for_in_any_order() =
    var d = decoder(sample(), Normal)

    d.enter_map()

    assert(text_of(d.get_text_bytes_in_map("b"), "") == "IETF", "b first")
    assert(int_of(d.get_int_in_map("a"), -1) == 1, "then a")

    d.exit_map()

// A label the map does not hold is `LabelNotFound`, and it is recoverable -- the decoder can be
// asked for something else afterwards.
@test
a_missing_label_is_recoverable() =
    var d = decoder(sample(), Normal)

    d.enter_map()

    val missing = d.get_int_in_map("nope")

    assert(failed(missing), "there is no such label")
    assert(why(missing) == LabelNotFound, "and it says so")

    d.take_error()

    assert(int_of(d.get_int_in_map("a"), -1) == 1, "and the decoder carries on")

// Asking for the wrong type is a different failure from asking for a label that is not there.
@test
the_wrong_type_is_its_own_failure() =
    var d = decoder(sample(), Normal)

    d.enter_map()

    val wrong = d.get_int_in_map("b")

    assert(why(wrong) == UnexpectedType, "b is text, not an integer")

// Integer labels, which is what a compact protocol uses.
@test
reads_a_map_by_integer_label() =
    // {1: 2, 3: 4}
    var d = decoder(unhex("a201020304"), Normal)

    d.enter_map()

    assert(int_of(d.get_int_in_map_at(3), -1) == 4, "label 3 holds 4")
    assert(int_of(d.get_int_in_map_at(1), -1) == 2, "label 1 holds 2")

    d.exit_map()

@test
enters_and_leaves_a_nested_map() =
    // {"outer": {"inner": 7}}
    var d = decoder(unhex("a1656f75746572a165696e6e657207"), Normal)

    d.enter_map()
    d.enter_map_in_map("outer")

    assert(int_of(d.get_int_in_map("inner"), -1) == 7, "the nested value")

    d.exit_map()
    d.exit_map()

    assert(finished(d), "both levels closed")

@test
enters_an_array_and_reads_it_in_order() =
    // {"xs": [20, 10]}
    var d = decoder(unhex("a162787382140a"), Normal)

    d.enter_map()
    d.enter_array_in_map("xs")

    assert(int_of(d.get_int(), -1) == 20, "the first element")
    assert(int_of(d.get_int(), -1) == 10, "the second element")

    d.exit_array()
    d.exit_map()

// ==================================================================================================
// Spiffy decode — tagged types
// ==================================================================================================

// 1(1363896240), from RFC 8949's table.
@test
reads_an_epoch_date() =
    var d = decoder(unhex("c11a514b67b0"), Normal)

    assert(int_of(d.get_epoch_date(Required), -1) == 1363896240, "the tagged form")

// **The borrowed form is the same content with no tag**, and asking for it under `Absent` is how a
// protocol whose schema already says "this is a date" reads one.
@test
reads_a_borrowed_epoch_date() =
    var d = decoder(unhex("1a514b67b0"), Normal)

    assert(int_of(d.get_epoch_date(Absent), -1) == 1363896240, "the borrowed form")

// And asking for the wrong one is a failure rather than a wrong answer.
//
// **A decoder per case, because errors are sticky.** An earlier version of this test reused one
// decoder for all three and the third failed -- correctly: a decoder that has met an error turns
// every later call into a no-op reporting that same error, which is exactly the property that lets a
// run of getters be checked once at the end.
@test
a_tag_requirement_is_enforced() =
    var tagged = decoder(unhex("c11a514b67b0"), Normal)
    var bare = decoder(unhex("1a514b67b0"), Normal)
    var either = decoder(unhex("c11a514b67b0"), Normal)

    assert(failed(tagged.get_epoch_date(Absent)), "a tag was there and should not have been")
    assert(failed(bare.get_epoch_date(Required)), "a tag was required and was not there")
    assert(!failed(either.get_epoch_date(Optional)), "either is accepted")

@test
reads_a_uri() =
    var d = decoder(unhex("d82076687474703a2f2f7777772e6578616d706c652e636f6d"), Normal)

    assert(text_of(d.get_uri(Required), "") == "http://www.example.com", "the URI")

// 2(h'010000000000000000') is 2^64. **The sign is the tag, not the bytes**, and this pins that the
// binding reports it separately rather than folding it in.
@test
reads_a_positive_bignum() =
    var d = decoder(unhex("c249010000000000000000"), Normal)

    d.get_bignum(Required) match
        Err(e) -> assert(false, e.message())
        Ok(n) ->
            assert(hex(n.bytes) == "010000000000000000", "the magnitude bytes")
            assert(!n.negative, "and it is positive")

@test
reads_a_negative_bignum() =
    var d = decoder(unhex("c349010000000000000000"), Normal)

    d.get_bignum(Required) match
        Err(e) -> assert(false, e.message())
        Ok(n) ->
            assert(hex(n.bytes) == "010000000000000000", "the same bytes as the positive case")
            assert(n.negative, "under the tag that makes them -1 minus the value")

// 4([-2, 27315]) is 273.15.
@test
reads_a_decimal_fraction() =
    var d = decoder(unhex("c48221196ab3"), Normal)

    d.get_decimal_fraction(Required) match
        Err(e) -> assert(false, e.message())
        Ok(v) ->
            assert(v.mantissa == 27315, "the mantissa")
            assert(v.exponent == -2, "and the base-ten exponent")

// 5([-1, 3]) is 1.5.
@test
reads_a_big_float() =
    var d = decoder(unhex("c5822003"), Normal)

    d.get_big_float(Required) match
        Err(e) -> assert(false, e.message())
        Ok(v) ->
            assert(v.mantissa == 3, "the mantissa")
            assert(v.exponent == -1, "and the base-two exponent")

// The `_big` forms take a scratch buffer, because a negative bignum mantissa has to be
// sign-converted and the converted bytes are not in the input.
@test
reads_a_decimal_fraction_with_a_wide_mantissa() =
    // 4([-2, 2(h'010000000000000000')])
    var d = decoder(unhex("c48221c249010000000000000000"), Normal)
    var scratch: []u8 = [0; 32]

    d.get_decimal_fraction_big(scratch, Required) match
        Err(e) -> assert(false, e.message())
        Ok(v) ->
            assert(hex(v.bytes) == "010000000000000000", "the wide mantissa")
            assert(!v.negative, "positive")
            assert(v.exponent == -2, "and the exponent")

// ==================================================================================================
// Spiffy decode — converting getters
// ==================================================================================================

// **One number written two ways is one number to the reader.** A protocol that has been through more
// than one implementation gets an amount as an integer from one peer and a float from another, and
// `convert` is what accepts both without the caller branching.
@test
a_converting_getter_accepts_more_than_one_type() =
    val accepted = convert_int | convert_float

    var whole = decoder(unhex("03"), Normal)
    var fractional = decoder(unhex("f94200"), Normal)

    assert(double_of(whole.get_double_convert(accepted), -1.0) == 3.0, "3 as a double")
    assert(double_of(fractional.get_double_convert(accepted), -1.0) == 3.0, "3.0 as a double")

// **`convert_all` is what reaches the mathematics.** Evaluating 4([-2, 27315]) as a double is
// `pow`, which is the only reason this package's module names `m` in its `@link` -- so a green run of
// this test is also what proves that link is right.
@test
convert_all_evaluates_a_decimal_fraction() =
    var d = decoder(unhex("c48221196ab3"), Normal)
    val accepted = convert_int | convert_decimal_fraction

    val v = double_of(d.get_double_convert_all(accepted), -1.0)

    assert(v > 273.149 && v < 273.151, "4([-2, 27315]) evaluates to 273.15")

// A type outside the accepted set is refused rather than coerced.
@test
a_converting_getter_refuses_what_it_was_not_told_to_accept() =
    var d = decoder(unhex("f94200"), Normal)

    assert(failed(d.get_int_convert(convert_int)), "a float is not in the accepted set")

// ==================================================================================================
// Bstr-wrapped CBOR, and subtrees as bytes
// ==================================================================================================

// The decoding half of the encoder's `bstr_wrap` -- how COSE reads a payload whose exact bytes were
// signed. The bytes come back as well as being entered, which is what a caller verifying a signature
// needs.
@test
enters_bstr_wrapped_cbor() =
    // A byte string holding the CBOR for [1, 2].
    var d = decoder(unhex("43820102"), Normal)

    d.enter_bstr_wrapped(Absent) match
        Err(e) -> assert(false, e.message())
        Ok(raw) -> assert(hex(raw) == "820102", "the wrapped bytes, for hashing")

    d.enter_array()

    assert(int_of(d.get_int(), -1) == 1, "and the content decodes")
    assert(int_of(d.get_int(), -1) == 2, "both of it")

    d.exit_array()
    d.exit_bstr_wrapped()

// A whole subtree as the bytes that encode it, without decoding inside -- for forwarding it
// untouched, or hashing exactly what a signature covers.
@test
reads_a_nested_map_as_bytes() =
    // {"outer": {"inner": 7}}
    var d = decoder(unhex("a1656f75746572a165696e6e657207"), Normal)

    d.enter_map()

    d.get_map_bytes_in_map("outer") match
        Err(e) -> assert(false, e.message())
        Ok(raw) -> assert(hex(raw) == "a165696e6e657207", "the nested map, undecoded")

    d.exit_map()

// ==================================================================================================
// Several labels in one pass
// ==================================================================================================

@test
fetches_several_labels_in_one_pass() =
    var d = decoder(sample(), Normal)
    var wanted = item_list(d)

    wanted.want("a", Int)
    wanted.want("c", Unset)

    d.enter_map()

    d.get_items(wanted) match
        Err(e) -> assert(false, e.message())
        Ok(_) ->
            wanted.at(0) match
                None -> assert(false, "the first result")
                Some(item) -> assert(is_int(item, 1), "a is 1")

            wanted.at(1) match
                None -> assert(false, "the second result")
                Some(item) -> assert(is_bool(item, true), "c is true")

    // Past the last label there is nothing.
    wanted.at(2) match
        None -> assert(true, "nothing past the last label")
        Some(_) -> assert(false, "only two labels were asked for")

    d.exit_map()

// **The callback sees the entries the list did NOT ask for**, which is QCBOR's rule and not the
// obvious reading. It is therefore not a validator for the values being fetched -- it is where a
// protocol decides what to do about a field its schema does not know.
//
// The first version of these two tests asked for the same label the callback then refused, and
// passed for the wrong reason: the callback never ran at all. `qcbor_decode.c` guards the call with
// `if(!bMatched && pCallBack != NULL)`.
//
// **The callback is a bare C function** -- `*extern(*u8, *u8) -> int`, whose address `&f` takes
// (`12 § 6a`). It has no environment, so everything it needs arrives as its two arguments, and
// `staged` turns them into an `Item`.
private refuse_unknown(ctx: *u8, item: *u8) -> int
    // Reached only for a label the list did not ask for, so its mere existence is the refusal.
    val ignored = staged(ctx, item)

    callback_fail
end refuse_unknown

// Nothing is left over, so the callback never fires and the read succeeds.
@test
a_callback_is_silent_when_the_schema_covers_the_map() =
    var d = decoder(sample(), Normal)
    var wanted = item_list(d)

    wanted.want("a", Int)
    wanted.want("b", TextString)
    wanted.want("c", Unset)

    d.enter_map()

    assert(!failed_unit(d.get_items_checking(wanted, &refuse_unknown)),
           "every entry was asked for, so nothing was left to refuse")

// Ask for one of three, and the other two are unknown fields the callback rejects.
@test
a_callback_that_refuses_stops_the_traversal() =
    var d = decoder(sample(), Normal)
    var wanted = item_list(d)

    wanted.want("a", Int)

    d.enter_map()

    assert(failed_unit(d.get_items_checking(wanted, &refuse_unknown)),
           "b and c were not asked for, and the callback refuses them")

// A list holds a bounded number of labels, and asking for one too many is refused rather than
// silently dropped.
@test
an_item_list_refuses_more_labels_than_it_holds() =
    var d = decoder(sample(), Normal)
    var wanted = item_list(d)

    var i: usize = 0

    while i < items_capacity
        wanted.want_at(long(i), Unset)
        i = i + 1

    wanted.want_at(999, Unset) match
        Ok(_) -> assert(false, "one past the capacity should be refused")
        Err(_) -> assert(true, "refused")

// ==================================================================================================
// Decode modes
// ==================================================================================================

// **`MapStringsOnly` turns a class of malformed input into one refusal.** A protocol that has said
// its maps are string-keyed gets `MapLabelType` for anything else, instead of a label it then has to
// check.
@test
strings_only_mode_refuses_an_integer_label() =
    // {1: 2}
    var strict = decoder(unhex("a10102"), MapStringsOnly)
    var lenient = decoder(unhex("a10102"), Normal)

    strict.next()

    assert(failed_next(strict.next()), "an integer label is refused")
    assert(!failed_next(lenient.next()), "and accepted in the ordinary mode")

// **`MapsAsArrays` is how a map with non-scalar labels is read at all**, and how duplicate labels
// stay visible rather than being merged. Entries arrive as elements: label, value, label, value.
@test
maps_as_arrays_mode_flattens_a_map() =
    // {"a": 1}
    var d = decoder(unhex("a1616101"), MapsAsArrays)

    d.next() match
        Err(e) -> assert(false, e.message())
        Ok(head) ->
            assert(head.kind() == MapAsArray, "the map arrives as an array")
            assert(is_count(head, 2), "of two elements, not one entry")

    d.next() match
        Err(e) -> assert(false, e.message())
        Ok(label) -> assert(is_text(label, "a"), "the label is an element of its own")

    d.next() match
        Err(e) -> assert(false, e.message())
        Ok(value) -> assert(is_int(value, 1), "and so is the value")

// ==================================================================================================
// Finishing, sequences and position
// ==================================================================================================

// **A decode is not correct until `finish` says so.** Bytes left over mean the input was not what it
// claimed, and this is how a protocol notices a message with something appended.
@test
trailing_bytes_are_caught_at_finish() =
    var d = decoder(unhex("0102"), Normal)

    d.next()

    d.finish() match
        Ok(_) -> assert(false, "there is a second item, so this is not one message")
        Err(e) -> assert(e.kind() == ExtraBytes, "and it says which")

// A CBOR **sequence** is several items in a row, where leftover bytes are the next message rather
// than an error. `partial_finish` says how much this decode consumed and `remaining` is the rest.
@test
a_sequence_is_read_one_message_at_a_time() =
    var d = decoder(unhex("0102"), Normal)

    d.next()

    d.partial_finish() match
        Err(e) -> assert(false, e.message())
        Ok(consumed) -> assert(consumed == 1, "one byte was this message")

    assert(hex(d.remaining()) == "02", "and the rest is the next one")

// `at_end` answers without consuming anything, which is what a loop over a sequence tests.
@test
at_end_reports_without_consuming() =
    var d = decoder(unhex("01"), Normal)

    assert(!d.at_end(), "there is an item")

    d.next()

    assert(d.at_end(), "and now there is not")

// `rewind` returns to the start of the entered map, which is what makes one readable twice.
@test
rewind_reads_a_map_again() =
    var d = decoder(sample(), Normal)

    d.enter_map()

    assert(int_of(d.get_int_in_map("a"), -1) == 1, "read once")

    d.rewind()

    assert(int_of(d.get_int_in_map("a"), -1) == 1, "and again after rewinding")

// `tell` is where in the input the traversal is.
@test
tell_reports_the_position() =
    var d = decoder(unhex("0102"), Normal)

    assert(d.tell() == 0, "at the start")

    d.next()

    assert(d.tell() == 1, "and after one one-byte item")

// ==================================================================================================
// The string pool for indefinite-length strings
// ==================================================================================================

// **Without a pool an indefinite-length string is `NoStringAllocator`**, because QCBOR allocates
// nothing and the chunks have nowhere to be joined. That is a clean refusal rather than a partial
// answer, and it is the reason the pool exists at all.
@test
an_indefinite_string_needs_a_pool() =
    // (_ "strea", "ming") — RFC 8949 appendix A
    var d = decoder(unhex("7f657374726561646d696e67ff"), Normal)

    d.next() match
        Ok(_) -> assert(false, "there is nowhere to join the chunks")
        Err(e) -> assert(e.kind() == NoStringAllocator, "and it says so")

@test
a_pool_joins_the_chunks_of_an_indefinite_string() =
    var d = decoder(unhex("7f657374726561646d696e67ff"), Normal)
    var pool: []u8 = [0; 256]

    assert(pool.len > mem_pool_overhead, "the pool must exceed QCBOR's own bookkeeping")

    d.set_mem_pool(pool, false) match
        Err(e) -> assert(false, e.message())
        Ok(_) ->
            d.next() match
                Err(e) -> assert(false, e.message())
                Ok(item) -> assert(is_text(item, "streaming"), "the chunks joined")

// ==================================================================================================
// Errors
// ==================================================================================================

private failed_next(r: Result[Item, Error]) -> bool =
    r match
        Err(_) -> true
        Ok(_) -> false

// **Not-well-formed is a different question from unsupported**, and a protocol that must tell a
// corrupt message from one it cannot read needs both. `1f` is major type 0 with an argument value
// that CBOR does not define, so it is not CBOR at all.
@test
a_malformed_input_is_reported_as_not_well_formed() =
    var d = decoder(unhex("1f"), Normal)

    d.next() match
        Ok(_) -> assert(false, "1f is not well-formed CBOR")
        Err(e) ->
            assert(e.not_well_formed(), "the bytes are not CBOR")
            assert(e.message() != "", "and QCBOR supplies a sentence for it")

// Running off the end is its own answer, and it is the one a loop over items stops on.
@test
running_out_of_items_is_its_own_error() =
    var d = decoder(unhex("01"), Normal)

    d.next()

    d.next() match
        Ok(_) -> assert(false, "there was only one item")
        Err(e) -> assert(e.kind() == NoMoreItems, "no more items")

// **The two sides' error lists must stay in step**, since `shim.c` maps QCBOR's sparse numbers onto
// the declaration order of `ErrorKind` and nothing but agreement keeps them aligned. Each of these
// is provoked for real rather than constructed, so a variant inserted in the wrong place moves an
// ordinal and one of them starts naming the wrong thing.
@test
the_error_kinds_line_up_with_the_c_side() =
    var small: []u8 = [0; 1]
    var e = encoder(small)

    e.add_text("too long for one byte")

    e.finish() match
        Ok(_) -> assert(false, "it does not fit")
        Err(err) -> assert(err.kind() == BufferTooSmall, "BufferTooSmall")

    var open_map_out: []u8 = [0; 32]
    var open_map = encoder(open_map_out)

    open_map.open_map()

    open_map.finish() match
        Ok(_) -> assert(false, "the map is open")
        Err(err) -> assert(err.kind() == ArrayOrMapStillOpen, "ArrayOrMapStillOpen")

    var trailing = decoder(unhex("0102"), Normal)

    trailing.next()

    trailing.finish() match
        Ok(_) -> assert(false, "there are trailing bytes")
        Err(err) -> assert(err.kind() == ExtraBytes, "ExtraBytes")

    var empty = decoder(unhex("01"), Normal)

    empty.next()

    empty.next() match
        Ok(_) -> assert(false, "there was one item")
        Err(err) -> assert(err.kind() == NoMoreItems, "NoMoreItems")

    var typed = decoder(sample(), Normal)

    typed.enter_map()

    typed.get_int_in_map("b") match
        Ok(_) -> assert(false, "b is text")
        Err(err) -> assert(err.kind() == UnexpectedType, "UnexpectedType")

    var absent = decoder(sample(), Normal)

    absent.enter_map()

    absent.get_int_in_map("zz") match
        Ok(_) -> assert(false, "there is no such label")
        Err(err) -> assert(err.kind() == LabelNotFound, "LabelNotFound")

// An error number QCBOR has and this binding has not heard of still prints, rather than stopping a
// `match` that has no arm for it. Constructed directly, because provoking one would need a QCBOR
// newer than this.
@test
an_unknown_error_number_still_reports() =
    val unknown = Error(200)

    assert(unknown.kind() == Other, "it lands on the catch-all")
    assert(unknown.message() != "", "and QCBOR still names it")
    assert(unknown.code == 200, "with the original number kept")

// ==================================================================================================
// An allocator of the caller's own
// ==================================================================================================

// What a bump allocator needs to remember: the block it draws from, how much is gone, and where the
// most recent allocation started.
//
// **This is what `ctx` is for.** A C callback has no environment (`12 § 6a`), so an allocator's state
// has to arrive through the one pointer QCBOR passes back untouched. Keeping it in a struct the test
// owns -- rather than in module storage -- is also what keeps `bump` an ordinary module function: a
// function that read a top-level binding of the entry file would become a *nested* function of that
// file's body (`13 § 7`), and a nested function has no address to take.
struct Arena
    block: []u8
    used: usize
    last: usize
end Arena

// A bump allocator, in the shape QCBOR's string allocator takes. It answers zero and writes the block
// through the out-parameters, or non-zero to refuse.
//
// **The reallocation mode is the one that matters and the one that is easy to get wrong.** An
// indefinite-length string arrives in chunks and QCBOR *grows* the block as each arrives -- and it
// grows it **in place**, which its own `MemPool_Function` does by returning the same pointer with a
// larger size. A first version of this allocator handed back fresh memory instead and the joined
// string came out as only its last chunk, which is what a test asserting the whole string is for.
private bump(ctx: *u8, old_mem: *u8, size: usize, out_ptr: **u8, out_len: *usize) -> int
    var arena: *Arena = ptr_cast(ctx)

    // A free, and the destruct call at `finish`: a bump allocator honours neither and need not.
    if size == 0 then
        return 0

    if old_mem != null then
        // Grow the most recent allocation where it stands, which is all QCBOR asks for.
        if (*arena).last + size > (*arena).block.len then
            return 1

        (*arena).used = (*arena).last + size

        *out_ptr = &(*arena).block[(*arena).last]
        *out_len = size

        return 0

    if (*arena).used + size > (*arena).block.len then
        return 1

    (*arena).last = (*arena).used

    *out_ptr = &(*arena).block[(*arena).used]
    *out_len = size

    (*arena).used = (*arena).used + size

    0
end bump

@test
a_caller_can_supply_its_own_allocator() =
    // (_ "strea", "ming") -- RFC 8949 appendix A, which needs somewhere to join the two chunks.
    var d = decoder(unhex("7f657374726561646d696e67ff"), Normal)
    var block: []u8 = [0; 256]
    var arena = Arena(block, 0, 0)

    d.set_allocator(&bump, ptr_cast(&arena), false)

    d.next() match
        Err(e) -> assert(false, e.message())
        Ok(item) -> assert(is_text(item, "streaming"), "the chunks joined in the caller's arena")

    assert(arena.used > 0, "and the arena is where they went")

// ==================================================================================================
// The README's examples
//
// **The README is reading material, so its programs are compiled here rather than trusted.** These
// are the same calls in the same order; only the `send` at the end of the encoding one is dropped,
// since that stands for whatever the reader does with the bytes.
// ==================================================================================================

@test
the_readme_encoding_example_works() =
    var out: []u8 = [0; 256]
    var e = encoder(out)

    e.open_map()
    e.label("name")
    e.add_text("ada")
    e.label("born")
    e.add_int(1815)
    e.label("tags")
    e.open_array()
    e.add_text("mathematician")
    e.add_text("writer")
    e.close_array()
    e.close_map()

    e.finish() match
        Err(why) -> assert(false, why.message())
        Ok(n) ->
            // a3 opens a map of three; each entry is its label then its value, in the order they
            // were written. 190717 is 1815, and 82 opens the two-element array of tags.
            assert(hex(out[0..<n]) ==
                   "a3646e616d65636164616462" +
                   "6f726e1907176474616773826d6d617468" +
                   "656d6174696369616e66777269746572",
                   "the map encodes exactly")

            // Read it back by label, which is the README's second decoding example.
            var d = decoder(out[0..<n], Normal)

            d.enter_map()

            assert(int_of(d.get_int_in_map("born"), -1) == 1815, "born is 1815")
            assert(text_of(d.get_text_bytes_in_map("name"), "") == "ada", "name is ada")

            d.exit_map()

            assert(finished(d), "and that was the whole message")

// The README's first decoding example — item by item, matching on what turns up.
@test
the_readme_item_by_item_example_works() =
    var d = decoder(unhex("6449455446"), Normal)

    d.next() match
        Err(why) -> assert(false, why.message())
        Ok(item) ->
            item.kind() match
                TextString -> assert(is_text(item, "IETF"), "a text string")
                _ -> assert(false, "it is a text string")

// ==================================================================================================
// QCBOR's own numbering
//
// Three translation tables used to live in `shim.c`, each mapping a QCBOR constant onto a dense
// ordinal that had to match the declaration order of an enum in another language, with nothing
// comparing the two halves. They are `match`es against `sh.sysl.qcbor.c` now, so the C compiler
// checks the names. What it cannot check is that the right *variant* is on the right side of an
// arrow, which is what the tests below are for.
// ==================================================================================================

// The one QCBOR value that is not a number a caller can read back out of anything: a tag
// requirement travels only inwards, so the numbers are pinned here rather than measured.
@test("a tag requirement carries QCBOR's own number")
tag_requirements_carry_qcbors_numbers()
    assert_eq(TagRequirement.Required.code(), 0, "the tag must be there")
    assert_eq(TagRequirement.Absent.code(), 1, "it must not")
    assert_eq(TagRequirement.Optional.code(), 2, "either")

    // The "allowing extra" half is the same three with QCBOR's bit OR'd on top.
    assert_eq(TagRequirement.RequiredAllowingExtra.code(), 0x80, "required, further tags allowed")
    assert_eq(TagRequirement.AbsentAllowingExtra.code(), 0x81, "absent, further tags allowed")
    assert_eq(TagRequirement.OptionalAllowingExtra.code(), 0x82, "either, further tags allowed")
end tag_requirements_carry_qcbors_numbers

// **This is the test that caught card 0105**, which the reshape walked into: a `u8` answered by a
// six-arm match reached the C as a different value, so every `Required` read was refused. It was
// worked around by widening `code()` and the shim's parameter to `int`; **sysl 0.0.48 fixed the
// compiler** -- a narrow scalar is extended to fill a register, as the convention requires -- and
// both went back to the `u8` QCBOR itself declares. So this is again a live check on the widening
// rather than a test of a boundary that had been moved out of its way.
//
// `a_tag_requirement_is_enforced` above is what went red; this says the same thing about the number
// rather than about the outcome, so a re-break names the cause.
@test("the requirement a getter is given is the one QCBOR acts on")
a_tag_requirement_reaches_the_library()
    var tagged = decoder(unhex("c11a514b67b0"), Normal)
    var bare = decoder(unhex("1a514b67b0"), Normal)

    assert(!failed(tagged.get_epoch_date(Required)), "a tagged date under Required")
    assert(failed(bare.get_epoch_date(Required)), "an untagged one under Required")
end a_tag_requirement_reaches_the_library

// Every `ItemKind` this binding claims QCBOR produces, read back off real CBOR. A variant on the
// wrong side of an arrow in `ItemKind.of` shows up here and nowhere else.
@test("an item's kind is the one QCBOR reported")
item_kinds_come_back_as_themselves()
    // QCBOR reports a small unsigned as `INT64` and only reaches for `UINT64` above 2^63,
    // which is the whole reason `Item` has both accessors.
    assert_eq(first_kind("01"), Int, "a small unsigned integer")
    assert_eq(first_kind("1bffffffffffffffff"), Uint, "one past what a long holds")
    assert_eq(first_kind("20"), Int, "a negative integer")
    assert_eq(first_kind("80"), Array, "an array")
    assert_eq(first_kind("a0"), Map, "a map")
    assert_eq(first_kind("41ff"), ByteString, "a byte string")
    assert_eq(first_kind("6161"), TextString, "a text string")
    assert_eq(first_kind("f4"), False, "false")
    assert_eq(first_kind("f5"), True, "true")
    assert_eq(first_kind("f6"), Null, "null")
    assert_eq(first_kind("f7"), Undef, "undefined")
    assert_eq(first_kind("f93c00"), Double, "a half-precision float, widened")
    assert_eq(first_kind("f0"), UnknownSimple, "a simple value CBOR has not named")
    assert_eq(first_kind("c11a514b67b0"), DateEpoch, "tag 1")
    assert_eq(first_kind("c074323031332d30332d32315432303a30343a30305a"), DateString, "tag 0")
    assert_eq(first_kind("c249010000000000000000"), PosBignum, "tag 2")
    assert_eq(first_kind("c349010000000000000000"), NegBignum, "tag 3")
    assert_eq(first_kind("c48221196ab3"), DecimalFraction, "tag 4")
    assert_eq(first_kind("c5822003"), BigFloat, "tag 5")
    assert_eq(first_kind("d8206c687474703a2f2f612e636f6d"), Uri, "tag 32")

    // The one kind that is a property of the decode rather than of the bytes.
    var m = decoder(unhex("a10102"), MapsAsArrays)

    assert_eq(kind_of(m.next()), MapAsArray, "a map read in MapsAsArrays mode")
end item_kinds_come_back_as_themselves

// The kind of the *label* of a map entry travels through the same match, by a different accessor.
@test("a map entry's label kind comes back as itself")
label_kinds_come_back_as_themselves()
    // {"a": 1}
    var d = decoder(unhex("a1616101"), Normal)

    d.next() match
        Err(e) -> assert(false, e.message())
        Ok(_) -> ()

    d.next() match
        Err(e) -> assert(false, e.message())
        Ok(item) -> assert_eq(item.label_kind().expect("a map entry has a label"), TextString,
                              "the label is text")
end label_kinds_come_back_as_themselves

private first_kind(hex: string) -> ItemKind
    var d = decoder(unhex(hex), Normal)

    kind_of(d.next())
end first_kind

private kind_of(r: Result[Item, Error]) -> ItemKind =
    r match
        Err(_) -> Unset
        Ok(item) -> item.kind()

// An enum prints as the thing it names rather than as its number, which is what makes `assert_eq`
// above legible and what a program reporting a refusal wants.
@test("the enums print as words")
the_enums_print_as_words()
    assert_eq(f"${ItemKind.TextString}", "text string", "an item kind")
    assert_eq(f"${ItemKind.DecimalFractionNegBignum}",
              "decimal fraction with a negative bignum mantissa", "a compound one")
    assert_eq(f"${ErrorKind.NoMoreItems}", "no more items", "an error kind")
    assert_eq(f"${TagRequirement.OptionalAllowingExtra}", "either, further tags allowed",
              "a tag requirement")
    assert_eq(f"${DecodeMode.MapsAsArrays}", "maps as arrays", "a decode mode")

    // `Error` prints QCBOR's own name for the number instead, which is more specific than the
    // kind's word and is what a report of an unrecognised failure has to fall back on.
    assert_eq(f"${Error(1)}", "QCBOR_ERR_BUFFER_TOO_SMALL", "an error itself")
    assert_eq(f"${Error(1).kind()}", "the buffer is too small", "and its kind, in words")
end the_enums_print_as_words
