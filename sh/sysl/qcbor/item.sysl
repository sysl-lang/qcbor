module sh.sysl.qcbor

import sh.sysl.qcbor.c
// Unqualified, which is the two-layer split applied to values: `c` names each constant under the
// header's spelling and this module re-exports it under a pleasant one. That started as a
// workaround -- a module-qualified `c const` was refused in a `const` initializer, card 0104,
// fixed in sysl 0.0.48 -- and it is kept because naming a thing twice is what the split is for.
import sh.sysl.qcbor.c.{CONVERT_TYPE_XINT64, CONVERT_TYPE_FLOAT, CONVERT_TYPE_BIG_NUM,
                        CONVERT_TYPE_DECIMAL_FRACTION, CONVERT_TYPE_BIGFLOAT, SUCCESS,
                        ERR_CALLBACK_FAIL, ITEM_LIST_CAPACITY}
import sysl.slices.as_ptr
import sysl.text.{from_utf8, Utf8Error}

// The values a decode produces: `Item` and the shapes read out of one.
//
// One of four files declaring `module sh.sysl.qcbor`; `qcbor.sysl` says what the others hold.

// An arbitrary-precision integer as it was decoded.
//
// `negative` is which tag carried it rather than anything in the bytes, and when it is true the bytes
// encode **-1 minus the value** -- so `h''` is -1 and `h'ff'` is -256.
struct Bignum
    bytes: []const u8
    negative: bool
end Bignum

// A MIME message, and whether it arrived under tag 257 (binary) rather than tag 36 (text).
struct MimeMessage
    bytes: []const u8
    binary: bool
end MimeMessage

// A decimal fraction or a big float whose mantissa fits a `long`. The value is the mantissa times ten
// or two to the exponent, depending on which one it came from.
struct ExpMantissa
    mantissa: long
    exponent: long
end ExpMantissa

// The same where the mantissa is too wide for a `long`. `bytes` may point into the input or into the
// scratch buffer that was supplied, and carries the same sign convention as `Bignum`.
struct BigMantissa
    bytes: []const u8
    negative: bool
    exponent: long
end BigMantissa

// Whether a tagged getter insists on the tag number.
//
// The three requirements each come in a plain form and one that tolerates further tags wrapped around
// the item -- QCBOR ORs a bit for that, and six named values is clearer than a second parameter
// threaded through eighty declarations.
enum TagRequirement
    // The tag number must be present. The self-describing form.
    Required
    // It must not be. The "borrowed" form, whose content stands alone because a schema already says
    // what it is -- the reading half of the encoder's `tagged: false`.
    Absent
    // Either is accepted.
    Optional
    RequiredAllowingExtra
    AbsentAllowingExtra
    OptionalAllowingExtra

    // The number QCBOR takes. The three plain requirements are values and "additional tags allowed"
    // is a bit OR'd on top, which is why six named variants beat a second parameter threaded
    // through eighty declarations.
    //
    // **`u8`, which is what QCBOR's own parameter is.** It was an `int`, and the shim's parameter
    // was widened to match, for as long as a `u8` answered by a six-arm match reached a C function
    // as a *different value* -- card 0105, whose reduction is this function almost exactly. Nothing
    // in sysl noticed: the value printed correctly on the line before the call that acted on
    // something else. sysl 0.0.48 widens a narrow scalar to fill a register, as every convention
    // but AArch64-away-from-Darwin and Windows requires, so the byte crosses as the byte it is.
    code(self) -> u8
        self match
            Required -> c.TAG_REQUIREMENT_TAG
            Absent -> c.TAG_REQUIREMENT_NOT_A_TAG
            Optional -> c.TAG_REQUIREMENT_OPTIONAL_TAG
            RequiredAllowingExtra -> c.TAG_REQUIREMENT_TAG | c.TAG_REQUIREMENT_ALLOW_ADDITIONAL_TAGS
            AbsentAllowingExtra ->
                c.TAG_REQUIREMENT_NOT_A_TAG | c.TAG_REQUIREMENT_ALLOW_ADDITIONAL_TAGS
            OptionalAllowingExtra ->
                c.TAG_REQUIREMENT_OPTIONAL_TAG | c.TAG_REQUIREMENT_ALLOW_ADDITIONAL_TAGS
end TagRequirement

// What a getter was told to insist on, for a diagnostic that has to say what it asked for.
impl Display for TagRequirement
    display(self, out: *Writer, fmt: FormatSpec)
        val s = self match
            Required -> "required"
            Absent -> "absent"
            Optional -> "either"
            RequiredAllowingExtra -> "required, further tags allowed"
            AbsentAllowingExtra -> "absent, further tags allowed"
            OptionalAllowingExtra -> "either, further tags allowed"

        display_str(s, out, fmt)

// A list of labels to fetch in one pass, and the results.
//
// **Its storage is its own** rather than part of the decoder, because a list is a kilobyte and most
// decoders never batch. A program that does not use this pays nothing for it.
struct ItemList
    storage: []u64
    handle: *c.ItemListCtx
    of: Decoder

    // Ask for a text label, and what type is expected of its value. `Unset` accepts any type, which
    // is what a caller who will inspect the kind themselves wants.
    want(self, label: string, expected: ItemKind) -> Result[unit, string]
        val b = label.bytes
        val code = c.items_want(self.handle, as_ptr(b), b.len, want_type(expected))

        if code == 0 then Ok(())
        elif code == 1 then Err("this list already holds as many labels as it can")
        else Err("the labels are longer together than the list's pool")
    end want

    // The same with an integer label.
    want_at(self, label: long, expected: ItemKind) -> Result[unit, string]
        val code = c.items_want_at(self.handle, label, want_type(expected))

        if code == 0 then Ok(()) else Err("this list already holds as many labels as it can")
    end want_at

    // The nth result, in the order the labels were asked for. `None` past the last.
    //
    // **The item is read through the decoder's one slot**, so it is replaced by the next `at` or by
    // any further decoding -- read the value out before moving on.
    at(self, index: usize) -> Option[Item] =
        if c.items_select(self.of.handle, self.handle, index) != 0 then Some(Item(self.of)) else None
end ItemList

// The QCBOR type a batch entry asks for, or `TYPE_ANY` where the caller will inspect the kind
// themselves.
//
// **QCBOR matches a batch entry on twelve types and not on all thirty-four**, so a kind outside that
// set is asked for as "any" and checked by the caller afterwards. This used to be a switch in
// `shim.c` keyed on the sysl enum's ordinal -- the third of three tables that had to agree with a
// declaration order in another language, and the only one running in this direction.
private want_type(k: ItemKind) -> int =
    k match
        Int -> c.TYPE_INT64
        Uint -> c.TYPE_UINT64
        Array -> c.TYPE_ARRAY
        Map -> c.TYPE_MAP
        ByteString -> c.TYPE_BYTE_STRING
        TextString -> c.TYPE_TEXT_STRING
        False -> c.TYPE_FALSE
        True -> c.TYPE_TRUE
        Null -> c.TYPE_NULL
        Undef -> c.TYPE_UNDEF
        Double -> c.TYPE_DOUBLE
        DateEpoch -> c.TYPE_DATE_EPOCH
        _ -> c.TYPE_ANY






// The seven above behind one entry point, chosen by `which`, so the sysl side has one dispatcher
// rather than seven bodies that differ in a name.



// The label discriminators the shim switches on. Named rather than written as 0, 1 and 2 at ninety
// call sites, which is where one of them would eventually be wrong.
private[qcbor] const lk_none: int = 0
private[qcbor] const lk_int: int = 1
private[qcbor] const lk_text: int = 2

// A NUL-terminated copy of a label, which is what QCBOR's by-name search takes.
//
// **The copy lives as long as the call and no longer**, which is all QCBOR needs: the search reads
// the label during the call and keeps nothing. The batch list is the exception and copies its labels
// into storage of its own, because there the labels have to survive until the run.
// The empty label, for the forms that take the next item rather than searching for one. Written as
// a named function rather than as a bare `[]` at ninety call sites, which reads better and gives the
// empty slice a type without an annotation.
private[qcbor] no_label() -> []const u8 = []

private[qcbor] result[T](err: int, value: T) -> Result[T, Error] =
    if err == 0 then Ok(value) else Err(Error(err))

private[qcbor] unit_result(err: int) -> Result[unit, Error] = if err == 0 then Ok(()) else Err(Error(err))

private[qcbor] str_result(err: int, p: *u8, n: usize) -> Result[[]const u8, Error] =
    if err != 0 then Err(Error(err))
    elif p == null then Ok([])
    else Ok(p[0..<n])

// The conversion bits the `_convert` getters take, OR'd together to say which CBOR types one call
// will accept.
//
// Constants rather than the calls these used to be, so `convert_int | convert_float` is folded at
// compile time and can be given a name with a `const` of its own.
const convert_int: u32 = CONVERT_TYPE_XINT64
const convert_float: u32 = CONVERT_TYPE_FLOAT
const convert_bignum: u32 = CONVERT_TYPE_BIG_NUM
const convert_decimal_fraction: u32 = CONVERT_TYPE_DECIMAL_FRACTION
const convert_big_float: u32 = CONVERT_TYPE_BIGFLOAT

// What a callback passed to `get_items_checking` returns to accept an item, and to refuse one.
const callback_ok: int = SUCCESS
const callback_fail: int = ERR_CALLBACK_FAIL

// How many labels one `ItemList` can hold.
const items_capacity: usize = ITEM_LIST_CAPACITY

// A list of labels to fetch from `of`'s entered map in one pass.
item_list(of: Decoder) -> ItemList
    var storage: []u64 = [0; c.ITEM_LIST_WORDS]

    // Cannot fail: the storage was just sized by asking C what it needs.
    ItemList(storage, c.items_init(&storage[0], storage.len), of)
end item_list

// One decoded item.
//
// **This is a view of the decoder's single item slot, not a copy of it**, so the next decode replaces
// what it reports. Reading a value out -- `int_value`, `text`, `count` -- before decoding again is
// the rule, and it is QCBOR's own: the strings point into the input rather than into the item, so
// there was never anything to copy.
struct Item
    of: Decoder

    // What this item is, which decides which accessor below answers.
    kind(self) -> ItemKind = ItemKind.of(c.item_kind(self.of.handle))

    // How deep this item sits. `nesting` is its own level and `next_nesting` is the level of the item
    // after it -- **a drop between them is how a definite- and an indefinite-length array both say
    // they have ended**, which is why a reader watches these rather than counting members.
    nesting(self) -> u8 = c.item_nesting(self.of.handle)
    next_nesting(self) -> u8 = c.item_next_nesting(self.of.handle)

    // -- Values ------------------------------------------------------------------------------------

    // The value of an `Int`, or of anything else that lands in the signed slot -- `DateEpoch` uses
    // `epoch_seconds` instead. `None` when the item is not one.
    int_value(self) -> Option[long] =
        if self.kind() == Int then Some(c.item_int64(self.of.handle)) else None

    // The value of a `Uint`. CBOR's unsigned range runs past what a `long` holds, which is why this
    // is separate rather than widened into `int_value`.
    uint_value(self) -> Option[ulong] =
        if self.kind() == Uint then Some(c.item_uint64(self.of.handle)) else None

    // A floating value. Half and single precision arrive here too, widened, because that is what
    // QCBOR does unless it is built without preferred float support.
    double_value(self) -> Option[real] =
        if self.kind() == Double then Some(c.item_double(self.of.handle))
        elif self.kind() == Float then Some(real(c.item_float(self.of.handle)))
        else None

    // `True` and `False` are separate CBOR simple values and separate kinds; this is the pair read as
    // one answer.
    bool_value(self) -> Option[bool] =
        if self.kind() == True then Some(true)
        elif self.kind() == False then Some(false)
        else None

    // The number of an `UnknownSimple` -- a simple value CBOR has not given a meaning.
    simple_value(self) -> Option[u8] =
        if self.kind() == UnknownSimple then Some(c.item_simple(self.of.handle)) else None

    // The bytes of a byte string, a text string, a bignum, or any of the tagged string types.
    //
    // **This is a slice of the input, not a copy.** It is valid exactly as long as the buffer the
    // decoder was given, which is the ordinary reading of a slice and is the whole reason decoding
    // needs no allocator.
    bytes(self) -> Option[[]const u8]
        val p = c.item_string_ptr(self.of.handle)
        val n = c.item_string_len(self.of.handle)

        if p == null then None else Some(p[0..<n])
    end bytes

    // The text of a text string or a tagged string type, decoded and copied.
    //
    // **This is the one accessor that allocates**, and it is where CBOR's promise that text is UTF-8
    // is actually checked -- the promise is the format's, and an encoder that broke it produces bytes
    // that arrive here. `Err` is bytes that are not valid UTF-8; `None` is an item that is not text
    // at all.
    text(self) -> Option[Result[string, Utf8Error]] =
        self.bytes() match
            None -> None
            Some(b) -> Some(from_utf8(b))

    // The member count of an `Array` or a `Map`. **`None` for an indefinite-length one**, which has
    // no count to report -- watch `next_nesting` for the end of those instead.
    count(self) -> Option[usize]
        val k = self.kind()

        if k != Array && k != Map && k != MapAsArray then
            None
        else
            val n = c.item_count(self.of.handle)

            if n == count_indefinite then None else Some(usize(n))
    end count

    // Seconds since 1970-01-01 for a `DateEpoch`, and the fractional part separately. A CBOR epoch
    // date may be a float, and QCBOR splits it so that the whole seconds stay exact.
    epoch_seconds(self) -> Option[long] =
        if self.kind() == DateEpoch then Some(c.item_epoch_seconds(self.of.handle)) else None

    epoch_fraction(self) -> Option[real] =
        if self.kind() == DateEpoch then Some(c.item_epoch_fraction(self.of.handle)) else None

    // Days since 1970-01-01 for a `DaysEpoch`.
    epoch_days(self) -> Option[long] =
        if self.kind() == DaysEpoch then Some(c.item_epoch_days(self.of.handle)) else None

    // The exponent of a decimal fraction or a big float, in base ten and base two respectively.
    exponent(self) -> Option[long] =
        if self.is_exp_mantissa() then Some(c.item_exponent(self.of.handle)) else None

    // The mantissa, when it fits a `long` -- which is what the plain `DecimalFraction` and `BigFloat`
    // kinds mean. The four `...Bignum` kinds put it in `mantissa_bytes` instead, and that is the
    // whole difference between them.
    mantissa(self) -> Option[long] =
        if self.kind() == DecimalFraction || self.kind() == BigFloat then
            Some(c.item_mantissa(self.of.handle))
        else
            None

    // The mantissa of one of the bignum forms, as bytes, with the same sign convention the encoding
    // side uses: a `Neg` kind's bytes encode -1 minus the value.
    mantissa_bytes(self) -> Option[[]const u8]
        val k = self.kind()

        if k != DecimalFractionPosBignum && k != DecimalFractionNegBignum &&
           k != BigFloatPosBignum && k != BigFloatNegBignum then
            None
        else
            val p = c.item_mantissa_ptr(self.of.handle)
            val n = c.item_mantissa_len(self.of.handle)

            if p == null then None else Some(p[0..<n])
    end mantissa_bytes

    private is_exp_mantissa(self) -> bool
        val k = self.kind()

        k == DecimalFraction || k == DecimalFractionPosBignum || k == DecimalFractionNegBignum ||
        k == BigFloat || k == BigFloatPosBignum || k == BigFloatNegBignum
    end is_exp_mantissa

    // -- The label, when this item is a map entry --------------------------------------------------

    // What kind of label this entry carries, or `None` at a level that is not a map.
    label_kind(self) -> Option[ItemKind]
        val k = ItemKind.of(c.item_label_kind(self.of.handle))

        if k == Unset then None else Some(k)
    end label_kind

    label_int(self) -> Option[long] =
        self.label_kind() match
            Some(Int) -> Some(c.item_label_int64(self.of.handle))
            _ -> None

    label_uint(self) -> Option[ulong] =
        self.label_kind() match
            Some(Uint) -> Some(c.item_label_uint64(self.of.handle))
            _ -> None

    // A text or byte-string label's bytes, a view into the input as `bytes` is.
    label_bytes(self) -> Option[[]const u8]
        val p = c.item_label_string_ptr(self.of.handle)
        val n = c.item_label_string_len(self.of.handle)

        self.label_kind() match
            Some(TextString) -> if p == null then None else Some(p[0..<n])
            Some(ByteString) -> if p == null then None else Some(p[0..<n])
            _ -> None
    end label_bytes

    // A text label, decoded and copied, which is the form a program written against a named schema
    // wants.
    label(self) -> Option[Result[string, Utf8Error]] =
        self.label_kind() match
            Some(TextString) ->
                self.label_bytes() match
                    None -> None
                    Some(b) -> Some(from_utf8(b))
            _ -> None

    // -- Tags --------------------------------------------------------------------------------------

    // The nth tag number on this item, innermost first, or `None` past the last one.
    //
    // **Read through here rather than off the item's own array**: QCBOR maps tag numbers wider than
    // sixteen bits into a small table, so the stored value is not always the tag.
    tag(self, index: u32) -> Option[u64]
        val t = c.item_tag(self.of.handle, index)

        if t == tag_invalid then None else Some(t)
    end tag

    // Every tag on this item, innermost first.
    //
    // Sized at `max_tags_per_item` and sliced back, rather than grown: QCBOR records a fixed
    // number of tags per item -- four, unless it was built otherwise -- so the bound is known before
    // the loop and asking C for it beats writing the number down.
    tags(self) -> []u64
        val limit = usize(max_tags_per_item)

        var found: []u64 = [0; limit]
        var n: usize = 0

        while n < limit
            self.tag(u32(n)) match
                None -> break
                Some(t) ->
                    found[n] = t
                    n = n + 1

        found[0..<n]
    end tags

    // Whether this item carries a given tag number anywhere in its stack.
    tagged_with(self, tag: u64) -> bool
        var i: u32 = 0

        while i < max_tags_per_item
            self.tag(i) match
                None -> return false
                Some(t) -> if t == tag then return true

            i = i + 1

        false
    end tagged_with
end Item


// The member count QCBOR reports for an array or a map whose length is indefinite. Private because
// it is a sentinel rather than a size: `Item.count` answers `None` for it, which is what a caller
// should be reading.

// Start decoding `input`.
//
// The storage is made here and held by the decoder, so there is nothing for a caller to size or keep
// alive. **`input` is not copied**, and every string the decode reports is a view into it, so it must
// outlive the values read out of it.
decoder(input: []const u8, mode: DecodeMode) -> Decoder
    var storage: []u64 = [0; decoder_words]

    // Cannot fail: the storage was just sized by asking C what it needs.
    decoder_with_storage(storage, input, mode).unwrap()
end decoder

// The same, for a program that will not allocate. `storage` must be at least `decoder_words` long.
decoder_with_storage(storage: []u64, input: []const u8, mode: DecodeMode) -> Result[Decoder, string]
    require storage.len > 0, "a decoder needs storage; size it with decoder_words"

    val ctx = c.decoder_init(&storage[0], storage.len, as_ptr(input), input.len, mode.code())

    if ctx == null then
        Err("the storage for a decoder is too small; size it with decoder_words")
    else
        Ok(Decoder(storage, input, ctx))
end decoder_with_storage
