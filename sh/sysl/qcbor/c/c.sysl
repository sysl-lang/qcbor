module sh.sysl.qcbor.c
@link("m")
@include("shim.h")

// QCBOR itself: every declaration that crosses into C, and nothing else.
//
// **The split keeps two jobs apart.** This one has to be *faithful* -- a signature disagreeing with
// the C header links perfectly and corrupts the call at run time, and nothing in this arrangement
// checks one against the other, so every declaration below was read out of `shim.c` rather than
// remembered. The rest of the package has to be *pleasant*, which is a different question and would
// otherwise be answered in the same breath.
//
// **The C lives in this directory too** -- `shim.c`, QCBOR's five translation units and their ten
// headers sit beside this file, so everything that is C is in one place literally rather than as a
// figure of speech. That is also what lets `@include("shim.h")` name the header with no path and no
// flag: a `c const` block below is compiled against the header sitting next to it.
//
// A caller may import this module and use it. `c.add_int64(h, 1)` reads as dropping into C on
// purpose, which is the whole value of the name; nothing here is hidden and nothing needs to be.
//
// **Nothing in QCBOR allocates, and nothing here frees.** There is no `destroy` below and no `impl
// Drop` anywhere in this package, because a context is storage the caller supplied and a decoded
// string is a view into the caller's input. That is the property CBOR exists for on a constrained
// device, and it is why the ownership machinery the other bindings in this org needed has nothing
// to do here.


// ==================================================================================================
// The three contexts
//
// Bodyless because nothing in sysl lays one out: each is a `#define`d size the C compiler measures
// and the caller supplies storage for (`15 §9`). Being three distinct types rather than three
// spellings of `*u8` is what stops a decoder being handed to something that wants an encoder.
// ==================================================================================================

opaque struct EncodeCtx

// QCBOR's decoding context and the slot the last decoded item sits in, together -- one type rather
// than two because an item has to live somewhere and one place is better than two (`shim.h`).
opaque struct DecodeCtx

opaque struct ItemListCtx


// ==================================================================================================
// Sizes and limits
//
// What is a value rather than a function is asked of the C compiler here. A shim reporting one
// through a call answers with something that is not a constant: it cannot size an array, stand in a
// `match` arm, or be folded into a bound.
// ==================================================================================================

c const
    // How many 64-bit words an encoding context needs. A caller sizes storage with this rather than
    // with a number somebody wrote down: `15 §7` is explicit that a transcribed `sizeof` compiles
    // everywhere and is correct on one machine.
    //
    // **Being a constant is what makes `[encode_words]u64` a legal array**, so a program with no
    // heap at all can hold an encoder's storage in its own frame.
    encode_context_words: usize = "(sizeof(QCBOREncodeContext) + sizeof(uint64_t) - 1) / sizeof(uint64_t)"

    // The most bytes `encode_head` can write, for sizing the buffer it is given.
    head_buffer_size: usize = "QCBOR_HEAD_BUFFER_SIZE"

    // How many 64-bit words a decoder's storage needs. Larger than an encoder's, because it sizes
    // the context and the item slot together -- which is why `SyslDecoder` is declared in `shim.h`
    // rather than inside `shim.c`: a constant is compiled outside the shim and has to be able to
    // name what it measures.
    decode_context_words: usize = "(sizeof(SyslDecoder) + sizeof(uint64_t) - 1) / sizeof(uint64_t)"

    // The most tags QCBOR records for one item. Tags beyond this are `TooManyTags`.
    qcbor_max_tags_per_item: u32 = "QCBOR_MAX_TAGS_PER_ITEM"

    // QCBOR's own overhead in a string pool, which a pool must exceed to be accepted.
    decode_min_mem_pool_size: usize = "QCBOR_DECODE_MIN_MEM_POOL_SIZE"

    // The member count QCBOR reports for an array or a map whose length is indefinite. A sentinel
    // rather than a size: `Item.count` answers `None` for it, which is what a caller reads.
    count_indicates_indefinite_length: u16 = "QCBOR_COUNT_INDICATES_INDEFINITE_LENGTH"


// ==================================================================================================
// The tag numbers RFC 8949 and the CBOR registry assign
//
// These are protocol constants rather than QCBOR's, fixed for all time by IANA, so a caller passing
// one to `add_tag` is naming something in the format rather than in this library. They are still
// read from the headers, for the reason `15 §7` gives: a `#define` has no symbol, and a number
// transcribed into sysl is a number that was right on one machine.
//
// `sh.sysl.qcbor` re-exports every one of them under the same name, so a caller writes
// `qcbor.tag_cwt` and never has to import this module for a tag.
// ==================================================================================================

c const
    cbor_tag_date_string: u64 = "CBOR_TAG_DATE_STRING"
    cbor_tag_date_epoch: u64 = "CBOR_TAG_DATE_EPOCH"
    cbor_tag_pos_bignum: u64 = "CBOR_TAG_POS_BIGNUM"
    cbor_tag_neg_bignum: u64 = "CBOR_TAG_NEG_BIGNUM"
    cbor_tag_decimal_fraction: u64 = "CBOR_TAG_DECIMAL_FRACTION"
    cbor_tag_bigfloat: u64 = "CBOR_TAG_BIGFLOAT"
    cbor_tag_cose_encrypt0: u64 = "CBOR_TAG_COSE_ENCRYPT0"
    cbor_tag_cose_mac0: u64 = "CBOR_TAG_COSE_MAC0"
    cbor_tag_cose_sign1: u64 = "CBOR_TAG_COSE_SIGN1"
    cbor_tag_enc_as_b64url: u64 = "CBOR_TAG_ENC_AS_B64URL"
    cbor_tag_enc_as_b64: u64 = "CBOR_TAG_ENC_AS_B64"
    cbor_tag_enc_as_b16: u64 = "CBOR_TAG_ENC_AS_B16"
    cbor_tag_cbor: u64 = "CBOR_TAG_CBOR"
    cbor_tag_uri: u64 = "CBOR_TAG_URI"
    cbor_tag_b64url: u64 = "CBOR_TAG_B64URL"
    cbor_tag_b64: u64 = "CBOR_TAG_B64"
    cbor_tag_regex: u64 = "CBOR_TAG_REGEX"
    cbor_tag_mime: u64 = "CBOR_TAG_MIME"
    cbor_tag_bin_uuid: u64 = "CBOR_TAG_BIN_UUID"
    cbor_tag_cwt: u64 = "CBOR_TAG_CWT"
    cbor_tag_cbor_sequence: u64 = "CBOR_TAG_CBOR_SEQUENCE"
    cbor_tag_cose_encrypt: u64 = "CBOR_TAG_COSE_ENCRYPT"
    cbor_tag_cose_mac: u64 = "CBOR_TAG_COSE_MAC"
    cbor_tag_cose_sign: u64 = "CBOR_TAG_COSE_SIGN"
    cbor_tag_days_epoch: u64 = "CBOR_TAG_DAYS_EPOCH"
    cbor_tag_days_string: u64 = "CBOR_TAG_DAYS_STRING"
    cbor_tag_geo_coord: u64 = "CBOR_TAG_GEO_COORD"
    cbor_tag_binary_mime: u64 = "CBOR_TAG_BINARY_MIME"
    cbor_tag_cbor_magic: u64 = "CBOR_TAG_CBOR_MAGIC"
    cbor_tag_invalid64: u64 = "CBOR_TAG_INVALID64"


