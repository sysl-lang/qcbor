module sh.sysl.qcbor.c
@link("m")
@include("shim.h")

// QCBOR itself: every declaration that crosses into C, and nothing else.
//
// **The split keeps two jobs apart.** This one has to be *faithful* -- a signature disagreeing with
// the C header links perfectly and corrupts the call at run time, and nothing in this arrangement
// checks one against the other, so every declaration below was read out of `shim.c` rather than
// remembered. The rest of the package has to be *pleasant*, which is a different question and would
// otherwise be answered in the same breath.
//
// **The C lives in this directory too** -- `shim.c`, QCBOR's five translation units and their ten
// headers sit beside this file, so everything that is C is in one place literally rather than as a
// figure of speech. That is also what lets `@include("shim.h")` name the header with no path and no
// flag: a `c const` block below is compiled against the header sitting next to it.
//
// A caller may import this module and use it. `c.add_int64(h, 1)` reads as dropping into C on
// purpose, which is the whole value of the name; nothing here is hidden and nothing needs to be.
//
// **Nothing in QCBOR allocates, and nothing here frees.** There is no `destroy` below and no `impl
// Drop` anywhere in this package, because a context is storage the caller supplied and a decoded
// string is a view into the caller's input. That is the property CBOR exists for on a constrained
// device, and it is why the ownership machinery the other bindings in this org needed has nothing
// to do here.


// ==================================================================================================
// The three contexts
//
// Bodyless because nothing in sysl lays one out: each is a `#define`d size the C compiler measures
// and the caller supplies storage for (`15 §9`). Being three distinct types rather than three
// spellings of `*u8` is what stops a decoder being handed to something that wants an encoder.
// ==================================================================================================

opaque struct EncodeCtx

// QCBOR's decoding context and the slot the last decoded item sits in, together -- one type rather
// than two because an item has to live somewhere and one place is better than two (`shim.h`).
opaque struct DecodeCtx

opaque struct ItemListCtx


// ==================================================================================================
// Sizes and limits
//
// What is a value rather than a function is asked of the C compiler here. A shim reporting one
// through a call answers with something that is not a constant: it cannot size an array, stand in a
// `match` arm, or be folded into a bound.
// ==================================================================================================

c const
    // How many 64-bit words an encoding context needs. A caller sizes storage with this rather than
    // with a number somebody wrote down: `15 §7` is explicit that a transcribed `sizeof` compiles
    // everywhere and is correct on one machine.
    //
    // **Being a constant is what makes `[encode_words]u64` a legal array**, so a program with no
    // heap at all can hold an encoder's storage in its own frame.
    ENCODE_CONTEXT_WORDS: usize = "(sizeof(QCBOREncodeContext) + sizeof(uint64_t) - 1) / sizeof(uint64_t)"

    // The most bytes `encode_head` can write, for sizing the buffer it is given.
    HEAD_BUFFER_SIZE: usize = "QCBOR_HEAD_BUFFER_SIZE"

    // How many 64-bit words a decoder's storage needs. Larger than an encoder's, because it sizes
    // the context and the item slot together -- which is why `SyslDecoder` is declared in `shim.h`
    // rather than inside `shim.c`: a constant is compiled outside the shim and has to be able to
    // name what it measures.
    DECODE_CONTEXT_WORDS: usize = "(sizeof(SyslDecoder) + sizeof(uint64_t) - 1) / sizeof(uint64_t)"

    // The most tags QCBOR records for one item. Tags beyond this are `TooManyTags`.
    MAX_TAGS_PER_ITEM: u32 = "QCBOR_MAX_TAGS_PER_ITEM"

    // QCBOR's own overhead in a string pool, which a pool must exceed to be accepted.
    DECODE_MIN_MEM_POOL_SIZE: usize = "QCBOR_DECODE_MIN_MEM_POOL_SIZE"

    // The member count QCBOR reports for an array or a map whose length is indefinite. A sentinel
    // rather than a size: `Item.count` answers `None` for it, which is what a caller reads.
    COUNT_INDICATES_INDEFINITE_LENGTH: u16 = "QCBOR_COUNT_INDICATES_INDEFINITE_LENGTH"


// ==================================================================================================
// The tag numbers RFC 8949 and the CBOR registry assign
//
// These are protocol constants rather than QCBOR's, fixed for all time by IANA, so a caller passing
// one to `add_tag` is naming something in the format rather than in this library. They are still
// read from the headers, for the reason `15 §7` gives: a `#define` has no symbol, and a number
// transcribed into sysl is a number that was right on one machine.
//
// `sh.sysl.qcbor` re-exports every one of them under the same name, so a caller writes
// `qcbor.tag_cwt` and never has to import this module for a tag.
// ==================================================================================================

c const
    TAG_DATE_STRING: u64 = "CBOR_TAG_DATE_STRING"
    TAG_DATE_EPOCH: u64 = "CBOR_TAG_DATE_EPOCH"
    TAG_POS_BIGNUM: u64 = "CBOR_TAG_POS_BIGNUM"
    TAG_NEG_BIGNUM: u64 = "CBOR_TAG_NEG_BIGNUM"
    TAG_DECIMAL_FRACTION: u64 = "CBOR_TAG_DECIMAL_FRACTION"
    TAG_BIGFLOAT: u64 = "CBOR_TAG_BIGFLOAT"
    TAG_COSE_ENCRYPT0: u64 = "CBOR_TAG_COSE_ENCRYPT0"
    TAG_COSE_MAC0: u64 = "CBOR_TAG_COSE_MAC0"
    TAG_COSE_SIGN1: u64 = "CBOR_TAG_COSE_SIGN1"
    TAG_ENC_AS_B64URL: u64 = "CBOR_TAG_ENC_AS_B64URL"
    TAG_ENC_AS_B64: u64 = "CBOR_TAG_ENC_AS_B64"
    TAG_ENC_AS_B16: u64 = "CBOR_TAG_ENC_AS_B16"
    TAG_CBOR: u64 = "CBOR_TAG_CBOR"
    TAG_URI: u64 = "CBOR_TAG_URI"
    TAG_B64URL: u64 = "CBOR_TAG_B64URL"
    TAG_B64: u64 = "CBOR_TAG_B64"
    TAG_REGEX: u64 = "CBOR_TAG_REGEX"
    TAG_MIME: u64 = "CBOR_TAG_MIME"
    TAG_BIN_UUID: u64 = "CBOR_TAG_BIN_UUID"
    TAG_CWT: u64 = "CBOR_TAG_CWT"
    TAG_CBOR_SEQUENCE: u64 = "CBOR_TAG_CBOR_SEQUENCE"
    TAG_COSE_ENCRYPT: u64 = "CBOR_TAG_COSE_ENCRYPT"
    TAG_COSE_MAC: u64 = "CBOR_TAG_COSE_MAC"
    TAG_COSE_SIGN: u64 = "CBOR_TAG_COSE_SIGN"
    TAG_DAYS_EPOCH: u64 = "CBOR_TAG_DAYS_EPOCH"
    TAG_DAYS_STRING: u64 = "CBOR_TAG_DAYS_STRING"
    TAG_GEO_COORD: u64 = "CBOR_TAG_GEO_COORD"
    TAG_BINARY_MIME: u64 = "CBOR_TAG_BINARY_MIME"
    TAG_CBOR_MAGIC: u64 = "CBOR_TAG_CBOR_MAGIC"
    TAG_INVALID64: u64 = "CBOR_TAG_INVALID64"



// ==================================================================================================
// QCBOR's own numbering
//
// **These replace three hand-written translation tables in `shim.c`**, each of which mapped a QCBOR
// constant to a dense ordinal that had to match the declaration order of an enum in another
// language. Nothing checked either half, and the package's own comment admitted it: *"the
// declaration order above IS the agreement with `shim.c`"*. Asking the C compiler for the values
// instead moves the correspondence into one `match` per enum, where a name that does not exist is a
// compile error and a variant with no arm is one too.
//
// The numbers are sparse and run past 78 with gaps, which is why the shim translated rather than
// crossing them raw. That was never the difficulty -- a `match` handles a sparse set as easily as a
// dense one, and the fallback arm is what the `default:` was.
// ==================================================================================================

// The failures QCBOR reports. `sh.sysl.qcbor.ErrorKind` matches on these.
//
// Three spellings share the value 48 -- `QCBOR_ERR_UNRECOVERABLE_TAG_CONTENT`,
// `QCBOR_ERR_BAD_TAG_CONTENT` and `QCBOR_ERR_BAD_OPT_TAG`. Only the middle one is named here,
// because two constant patterns of equal value cannot both be arms of one match, and it is the
// spelling QCBOR's own header presents first.
c const
    SUCCESS: int = "QCBOR_SUCCESS"
    ERR_BUFFER_TOO_SMALL: int = "QCBOR_ERR_BUFFER_TOO_SMALL"
    ERR_ENCODE_UNSUPPORTED: int = "QCBOR_ERR_ENCODE_UNSUPPORTED"
    ERR_BUFFER_TOO_LARGE: int = "QCBOR_ERR_BUFFER_TOO_LARGE"
    ERR_ARRAY_NESTING_TOO_DEEP: int = "QCBOR_ERR_ARRAY_NESTING_TOO_DEEP"
    ERR_CLOSE_MISMATCH: int = "QCBOR_ERR_CLOSE_MISMATCH"
    ERR_ARRAY_TOO_LONG: int = "QCBOR_ERR_ARRAY_TOO_LONG"
    ERR_TOO_MANY_CLOSES: int = "QCBOR_ERR_TOO_MANY_CLOSES"
    ERR_ARRAY_OR_MAP_STILL_OPEN: int = "QCBOR_ERR_ARRAY_OR_MAP_STILL_OPEN"
    ERR_OPEN_BYTE_STRING: int = "QCBOR_ERR_OPEN_BYTE_STRING"
    ERR_CANNOT_CANCEL: int = "QCBOR_ERR_CANNOT_CANCEL"
    ERR_EXTRA_BYTES: int = "QCBOR_ERR_EXTRA_BYTES"
    ERR_UNSUPPORTED: int = "QCBOR_ERR_UNSUPPORTED"
    ERR_ARRAY_OR_MAP_UNCONSUMED: int = "QCBOR_ERR_ARRAY_OR_MAP_UNCONSUMED"
    ERR_BAD_INT: int = "QCBOR_ERR_BAD_INT"
    ERR_INDEFINITE_STRING_CHUNK: int = "QCBOR_ERR_INDEFINITE_STRING_CHUNK"
    ERR_HIT_END: int = "QCBOR_ERR_HIT_END"
    ERR_BAD_BREAK: int = "QCBOR_ERR_BAD_BREAK"
    ERR_INPUT_TOO_LARGE: int = "QCBOR_ERR_INPUT_TOO_LARGE"
    ERR_ARRAY_DECODE_NESTING_TOO_DEEP: int = "QCBOR_ERR_ARRAY_DECODE_NESTING_TOO_DEEP"
    ERR_ARRAY_DECODE_TOO_LONG: int = "QCBOR_ERR_ARRAY_DECODE_TOO_LONG"
    ERR_STRING_TOO_LONG: int = "QCBOR_ERR_STRING_TOO_LONG"
    ERR_BAD_EXP_AND_MANTISSA: int = "QCBOR_ERR_BAD_EXP_AND_MANTISSA"
    ERR_NO_STRING_ALLOCATOR: int = "QCBOR_ERR_NO_STRING_ALLOCATOR"
    ERR_STRING_ALLOCATE: int = "QCBOR_ERR_STRING_ALLOCATE"
    ERR_MAP_LABEL_TYPE: int = "QCBOR_ERR_MAP_LABEL_TYPE"
    ERR_BAD_TAG_CONTENT: int = "QCBOR_ERR_BAD_TAG_CONTENT"
    ERR_INDEF_LEN_STRINGS_DISABLED: int = "QCBOR_ERR_INDEF_LEN_STRINGS_DISABLED"
    ERR_INDEF_LEN_ARRAYS_DISABLED: int = "QCBOR_ERR_INDEF_LEN_ARRAYS_DISABLED"
    ERR_TAGS_DISABLED: int = "QCBOR_ERR_TAGS_DISABLED"
    ERR_TOO_MANY_TAGS: int = "QCBOR_ERR_TOO_MANY_TAGS"
    ERR_UNEXPECTED_TYPE: int = "QCBOR_ERR_UNEXPECTED_TYPE"
    ERR_DUPLICATE_LABEL: int = "QCBOR_ERR_DUPLICATE_LABEL"
    ERR_MEM_POOL_SIZE: int = "QCBOR_ERR_MEM_POOL_SIZE"
    ERR_INT_OVERFLOW: int = "QCBOR_ERR_INT_OVERFLOW"
    ERR_DATE_OVERFLOW: int = "QCBOR_ERR_DATE_OVERFLOW"
    ERR_EXIT_MISMATCH: int = "QCBOR_ERR_EXIT_MISMATCH"
    ERR_NO_MORE_ITEMS: int = "QCBOR_ERR_NO_MORE_ITEMS"
    ERR_LABEL_NOT_FOUND: int = "QCBOR_ERR_LABEL_NOT_FOUND"
    ERR_NUMBER_SIGN_CONVERSION: int = "QCBOR_ERR_NUMBER_SIGN_CONVERSION"
    ERR_CONVERSION_UNDER_OVER_FLOW: int = "QCBOR_ERR_CONVERSION_UNDER_OVER_FLOW"
    ERR_MAP_NOT_ENTERED: int = "QCBOR_ERR_MAP_NOT_ENTERED"
    ERR_CALLBACK_FAIL: int = "QCBOR_ERR_CALLBACK_FAIL"
    ERR_FLOAT_DATE_DISABLED: int = "QCBOR_ERR_FLOAT_DATE_DISABLED"
    ERR_HALF_PRECISION_DISABLED: int = "QCBOR_ERR_HALF_PRECISION_DISABLED"
    ERR_HW_FLOAT_DISABLED: int = "QCBOR_ERR_HW_FLOAT_DISABLED"
    ERR_FLOAT_EXCEPTION: int = "QCBOR_ERR_FLOAT_EXCEPTION"
    ERR_ALL_FLOAT_DISABLED: int = "QCBOR_ERR_ALL_FLOAT_DISABLED"
    ERR_RECOVERABLE_BAD_TAG_CONTENT: int = "QCBOR_ERR_RECOVERABLE_BAD_TAG_CONTENT"
    ERR_CANNOT_ENTER_ALLOCATED_STRING: int = "QCBOR_ERR_CANNOT_ENTER_ALLOCATED_STRING"

// The conversions a `_convert` getter will accept, OR'd together. A set of bits rather than a
// number, so `CONVERT_TYPE_XINT64 | CONVERT_TYPE_FLOAT` is one call that takes either.
c const
    CONVERT_TYPE_XINT64: u32 = "QCBOR_CONVERT_TYPE_XINT64"
    CONVERT_TYPE_FLOAT: u32 = "QCBOR_CONVERT_TYPE_FLOAT"
    CONVERT_TYPE_BIG_NUM: u32 = "QCBOR_CONVERT_TYPE_BIG_NUM"
    CONVERT_TYPE_DECIMAL_FRACTION: u32 = "QCBOR_CONVERT_TYPE_DECIMAL_FRACTION"
    CONVERT_TYPE_BIGFLOAT: u32 = "QCBOR_CONVERT_TYPE_BIGFLOAT"

// Whether a tagged getter insists on the tag number. The first three are the requirement and the
// fourth is a bit OR'd on top of one of them, which is what `TagRequirement`'s six variants are.
//
// `u8`, which is what QCBOR's own parameter is. The four were `int` for as long as a narrow scalar
// could not be trusted across the boundary; sysl 0.0.48 widens one to fill a register, as the
// convention requires, so the shim takes the byte QCBOR takes and there is no cast in between.
c const
    TAG_REQUIREMENT_TAG: u8 = "QCBOR_TAG_REQUIREMENT_TAG"
    TAG_REQUIREMENT_NOT_A_TAG: u8 = "QCBOR_TAG_REQUIREMENT_NOT_A_TAG"
    TAG_REQUIREMENT_OPTIONAL_TAG: u8 = "QCBOR_TAG_REQUIREMENT_OPTIONAL_TAG"
    TAG_REQUIREMENT_ALLOW_ADDITIONAL_TAGS: u8 = "QCBOR_TAG_REQUIREMENT_ALLOW_ADDITIONAL_TAGS"

// How a map's labels are read, which is fixed when the decoder is made.
c const
    DECODE_MODE_NORMAL: int = "QCBOR_DECODE_MODE_NORMAL"
    DECODE_MODE_MAP_STRINGS_ONLY: int = "QCBOR_DECODE_MODE_MAP_STRINGS_ONLY"
    DECODE_MODE_MAP_AS_ARRAY: int = "QCBOR_DECODE_MODE_MAP_AS_ARRAY"

// The batch list: how many 64-bit words one needs, and how many labels it holds.
c const
    ITEM_LIST_WORDS: usize = "(sizeof(SyslItemList) + sizeof(uint64_t) - 1) / sizeof(uint64_t)"
    ITEM_LIST_CAPACITY: usize = "SYSL_ITEMS_MAX"

// What a decoded item is -- `QCBORItem.uDataType`, and `uLabelType` for a map entry's label.
// `sh.sysl.qcbor.ItemKind` matches on these.
c const
    // Not a type QCBOR ever reports: it is what a batch entry asks for when any type will do.
    TYPE_ANY: int = "QCBOR_TYPE_ANY"

    TYPE_NONE: int = "QCBOR_TYPE_NONE"
    TYPE_INT64: int = "QCBOR_TYPE_INT64"
    TYPE_UINT64: int = "QCBOR_TYPE_UINT64"
    TYPE_ARRAY: int = "QCBOR_TYPE_ARRAY"
    TYPE_MAP: int = "QCBOR_TYPE_MAP"
    TYPE_BYTE_STRING: int = "QCBOR_TYPE_BYTE_STRING"
    TYPE_TEXT_STRING: int = "QCBOR_TYPE_TEXT_STRING"
    TYPE_POSBIGNUM: int = "QCBOR_TYPE_POSBIGNUM"
    TYPE_NEGBIGNUM: int = "QCBOR_TYPE_NEGBIGNUM"
    TYPE_DATE_STRING: int = "QCBOR_TYPE_DATE_STRING"
    TYPE_DATE_EPOCH: int = "QCBOR_TYPE_DATE_EPOCH"
    TYPE_UKNOWN_SIMPLE: int = "QCBOR_TYPE_UKNOWN_SIMPLE"
    TYPE_DECIMAL_FRACTION: int = "QCBOR_TYPE_DECIMAL_FRACTION"
    TYPE_DECIMAL_FRACTION_POS_BIGNUM: int = "QCBOR_TYPE_DECIMAL_FRACTION_POS_BIGNUM"
    TYPE_DECIMAL_FRACTION_NEG_BIGNUM: int = "QCBOR_TYPE_DECIMAL_FRACTION_NEG_BIGNUM"
    TYPE_BIGFLOAT: int = "QCBOR_TYPE_BIGFLOAT"
    TYPE_BIGFLOAT_POS_BIGNUM: int = "QCBOR_TYPE_BIGFLOAT_POS_BIGNUM"
    TYPE_BIGFLOAT_NEG_BIGNUM: int = "QCBOR_TYPE_BIGFLOAT_NEG_BIGNUM"
    TYPE_FALSE: int = "QCBOR_TYPE_FALSE"
    TYPE_TRUE: int = "QCBOR_TYPE_TRUE"
    TYPE_NULL: int = "QCBOR_TYPE_NULL"
    TYPE_UNDEF: int = "QCBOR_TYPE_UNDEF"
    TYPE_FLOAT: int = "QCBOR_TYPE_FLOAT"
    TYPE_DOUBLE: int = "QCBOR_TYPE_DOUBLE"
    TYPE_MAP_AS_ARRAY: int = "QCBOR_TYPE_MAP_AS_ARRAY"
    TYPE_URI: int = "QCBOR_TYPE_URI"
    TYPE_BASE64URL: int = "QCBOR_TYPE_BASE64URL"
    TYPE_BASE64: int = "QCBOR_TYPE_BASE64"
    TYPE_REGEX: int = "QCBOR_TYPE_REGEX"
    TYPE_MIME: int = "QCBOR_TYPE_MIME"
    TYPE_UUID: int = "QCBOR_TYPE_UUID"
    TYPE_BINARY_MIME: int = "QCBOR_TYPE_BINARY_MIME"
    TYPE_DAYS_STRING: int = "QCBOR_TYPE_DAYS_STRING"
    TYPE_DAYS_EPOCH: int = "QCBOR_TYPE_DAYS_EPOCH"

