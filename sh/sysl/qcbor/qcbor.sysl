module sh.sysl.qcbor
@link("m")
@include("shim.h")

import sysl.text.from_cstring

// CBOR (RFC 8949), bound to QCBOR 1.6.1.
//
// **The module is four files and this is its front door**, holding the failures every other one
// reports and the tag numbers the format assigns:
//
//     qcbor.sysl    errors, the RFC 8949 tag numbers, helpers the rest share
//     encode.sysl   `Encoder`, and encoding a bare item head
//     decode.sysl   `Decoder` -- traversal, the bounded getters, the string pool
//     item.sysl     `Item` and the values read out of one
//
// They all declare `module sh.sysl.qcbor`, so a caller importing that gets the whole of it and the
// split is invisible from outside. What decided the boundaries is that a struct's methods live in
// its declaration: `Decoder` and `Item` are large and cannot be divided, so they get a file each.
//
// The C sits beside them and is compiled as part of the library (`15 §7`), so **nothing has to be
// installed to use this package**, and the only `@link` is `m` -- the mathematics, which the
// decoder's numeric coercions reach for and nothing else does. `package.hocon` says why that is a
// link directive rather than a capability.
//
// **QCBOR allocates nothing, and this binding keeps that.** A context is storage the caller supplies;
// an encoder writes into a buffer the caller supplies; a decoded string is a view into the input the
// caller supplied. Nothing here calls `malloc`, which is what lets CBOR -- a format designed for
// constrained devices -- be encoded on one.
//
// What crosses the boundary is a pointer and a length, in both directions, because QCBOR says "a
// string" with a `UsefulBufC` and a struct passed by value has no sysl spelling. `shim.c` splits
// every one of them, and also reaches the two hundred-odd `static inline` functions that have no
// symbol for an `extern` to name.
//
// **What is a value rather than a function is asked of the C compiler in a `c const` block.** The
// tag numbers, the two context sizes and the limits are `#define`s, so nothing links to them -- and
// a shim reporting one through a call answers with something that is not a constant: it cannot size
// an array, stand in a match arm, or be folded into a bound. `@include("shim.h")` is the header
// those expressions are compiled against, and it carries QCBOR's own with it; a file with no `c
// const` block in it does not name the header, which is why `decode.sysl` has no `@include`.

// ==================================================================================================
// Errors
// ==================================================================================================

// What went wrong, as QCBOR reports it.
//
// **The number is kept rather than discarded** so that `message` is QCBOR's own text for exactly this
// failure, including for a code this binding has not heard of. `kind` is the matchable form.
struct Error
    code: int

    // QCBOR's own description. Never empty: it answers "Unidentified error" for a number it does not
    // know, and the bytes are static storage in C, so the decode cannot fail on a dangling pointer.
    message(self) -> string = from_cstring_or(c_error_message(self.code), "unidentified error")

    kind(self) -> ErrorKind = error_kind(c_error_ordinal(self.code))

    // Whether the input is not CBOR at all, as against CBOR this decoder would not accept. The
    // distinction matters to a protocol that must tell a corrupt message from an unsupported one.
    not_well_formed(self) -> bool = c_error_is_not_well_formed(self.code) != 0

    // Whether decoding can continue past this. A recoverable error leaves the decoder positioned to
    // try the next item; an unrecoverable one means the traversal itself is lost.
    unrecoverable(self) -> bool = c_error_is_unrecoverable(self.code) != 0
end Error

// An `Error` renders as QCBOR's own sentence for it, so `f"${err}"` and printing a failed `Result`
// both say something a reader can act on rather than a number.
impl Display for Error
    display(self, out: *Writer, fmt: FormatSpec) = display_str(self.message(), out, fmt)

// The failures QCBOR names, for matching on.
//
// `Other` exists because a QCBOR newer than this binding may report something not listed here.
// Answering `Other` keeps such a program running and printing rather than stopping at a `match` with
// no arm for it, and `Error.code` still carries the number QCBOR gave.
//
// **No variant carries a payload, and that is deliberate.** The raw number belongs to `Error`, which
// is where `message` reads it from; putting it here too would be two places to keep agreeing. It
// also leaves this a plain enum, so `==` compares two kinds without an `Eq` written over fifty
// variants by hand.
enum ErrorKind
    Success
    BufferTooSmall
    EncodeUnsupported
    BufferTooLarge
    ArrayNestingTooDeep
    CloseMismatch
    ArrayTooLong
    TooManyCloses
    ArrayOrMapStillOpen
    OpenByteString
    CannotCancel
    ExtraBytes
    Unsupported
    ArrayOrMapUnconsumed
    BadInt
    IndefiniteStringChunk
    HitEnd
    BadBreak
    InputTooLarge
    ArrayDecodeNestingTooDeep
    ArrayDecodeTooLong
    StringTooLong
    BadExpAndMantissa
    NoStringAllocator
    StringAllocate
    MapLabelType
    BadTagContent
    IndefLenStringsDisabled
    IndefLenArraysDisabled
    TagsDisabled
    TooManyTags
    UnexpectedType
    DuplicateLabel
    MemPoolSize
    IntOverflow
    DateOverflow
    ExitMismatch
    NoMoreItems
    LabelNotFound
    NumberSignConversion
    ConversionUnderOverFlow
    MapNotEntered
    CallbackFail
    FloatDateDisabled
    HalfPrecisionDisabled
    HwFloatDisabled
    FloatException
    AllFloatDisabled
    RecoverableBadTagContent
    CannotEnterAllocatedString
    Other
end ErrorKind

// **The declaration order above IS the agreement with `shim.c`**, whose `ORDINAL_` list runs down the
// same names in the same order. Nothing restates it here: the discriminants are implicit, so they are
// 0 upward in declaration order, and `try` is the fallible constructor `09 §2` provides for exactly
// this -- an integer off a wire, or out of a C shim, that may not be a declared value.
//
// A number this binding has not heard of lands on `Other` rather than trapping, which is what keeps
// a program running against a QCBOR newer than the list.
//
// Comparing two kinds is what a caller branching on a failure does, and it needs nothing written
// here: a simple enum *is* its discriminant, so it carries `==` by rule (`09 §2`, `14 §5`). This
// binding used to say that itself, in an `impl Eq` performing the same comparison.
private error_kind(ordinal: int) -> ErrorKind = ErrorKind.try(ordinal).unwrap_or(Other)

extern "sysl_qcbor_error_ordinal" c_error_ordinal(err: int) -> int
extern "sysl_qcbor_error_message" c_error_message(err: int) -> *u8
extern "sysl_qcbor_error_is_not_well_formed" c_error_is_not_well_formed(err: int) -> int
extern "sysl_qcbor_error_is_unrecoverable" c_error_is_unrecoverable(err: int) -> int

// ==================================================================================================
// The tag numbers RFC 8949 and the CBOR registry assign
//
// These are protocol constants rather than QCBOR's, so they are fixed for all time by IANA, and a
// caller passing one to `add_tag` is naming something in the format rather than in this library.
// They are still read from the headers, for the reason `15 §7` gives: a `#define` has no symbol, and
// a number transcribed into sysl is a number that was right on one machine.
//
// **They are constants rather than functions**, so `tag_cwt` is a value a `match` arm can be written
// against and a `const` can be defined from. That is what a `c const` block buys over the thirty
// shim functions this used to be: the C compiler is asked at build time and the answer is folded in.
// ==================================================================================================

c const
    // An RFC 3339 date, as text.
    tag_date_string: u64 = "CBOR_TAG_DATE_STRING"
    // Seconds since 1970-01-01, as an integer or a float.
    tag_date_epoch: u64 = "CBOR_TAG_DATE_EPOCH"
    // An arbitrary-precision integer, big-endian, in a byte string.
    tag_pos_bignum: u64 = "CBOR_TAG_POS_BIGNUM"
    // The same, for a negative value: the bytes encode -1 minus the number.
    tag_neg_bignum: u64 = "CBOR_TAG_NEG_BIGNUM"
    // `[exponent, mantissa]`, the value being mantissa times ten to the exponent.
    tag_decimal_fraction: u64 = "CBOR_TAG_DECIMAL_FRACTION"
    // The same with a base of two.
    tag_bigfloat: u64 = "CBOR_TAG_BIGFLOAT"
    tag_cose_encrypt0: u64 = "CBOR_TAG_COSE_ENCRYPT0"
    tag_cose_mac0: u64 = "CBOR_TAG_COSE_MAC0"
    tag_cose_sign1: u64 = "CBOR_TAG_COSE_SIGN1"
    // "Render this item as base64url if it is converted to JSON", and its two neighbours.
    tag_enc_as_b64url: u64 = "CBOR_TAG_ENC_AS_B64URL"
    tag_enc_as_b64: u64 = "CBOR_TAG_ENC_AS_B64"
    tag_enc_as_b16: u64 = "CBOR_TAG_ENC_AS_B16"
    // A byte string whose content is itself CBOR.
    tag_cbor: u64 = "CBOR_TAG_CBOR"
    tag_uri: u64 = "CBOR_TAG_URI"
    tag_b64url: u64 = "CBOR_TAG_B64URL"
    tag_b64: u64 = "CBOR_TAG_B64"
    tag_regex: u64 = "CBOR_TAG_REGEX"
    tag_mime: u64 = "CBOR_TAG_MIME"
    tag_bin_uuid: u64 = "CBOR_TAG_BIN_UUID"
    tag_cwt: u64 = "CBOR_TAG_CWT"
    tag_cbor_sequence: u64 = "CBOR_TAG_CBOR_SEQUENCE"
    tag_cose_encrypt: u64 = "CBOR_TAG_COSE_ENCRYPT"
    tag_cose_mac: u64 = "CBOR_TAG_COSE_MAC"
    tag_cose_sign: u64 = "CBOR_TAG_COSE_SIGN"
    // Days since 1970-01-01, and the RFC 3339 full-date text form.
    tag_days_epoch: u64 = "CBOR_TAG_DAYS_EPOCH"
    tag_days_string: u64 = "CBOR_TAG_DAYS_STRING"
    tag_geo_coord: u64 = "CBOR_TAG_GEO_COORD"
    tag_binary_mime: u64 = "CBOR_TAG_BINARY_MIME"
    // The self-describing prefix, `d9 d9f7`, which marks a file as CBOR.
    tag_cbor_magic: u64 = "CBOR_TAG_CBOR_MAGIC"
    // The number no tag may have, which is how QCBOR says "no tag here".
    tag_invalid: u64 = "CBOR_TAG_INVALID64"

// ==================================================================================================
// Shared helpers
// ==================================================================================================

private[qcbor] flag(b: bool) -> int = if b then 1 else 0

// Decode a NUL-terminated string from C, falling back where the bytes are not UTF-8.
//
// The fallback keeps the signature honest for text that only ever comes from QCBOR's own static
// tables: a message that will not decode says the same thing to a caller as no message at all, and a
// `Result` here would make every caller handle a case that cannot arise from this library.
private from_cstring_or(p: *u8, fallback: string) -> string
    if p == null then
        fallback
    else
        from_cstring(p) match
            Ok(s) -> s
            Err(_) -> fallback
end from_cstring_or
