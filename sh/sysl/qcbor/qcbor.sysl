extern "sysl_qcbor_encode_add_tag" c_add_tag(ctx: *EncodeCtx, tag: u64)
extern "sysl_qcbor_encode_add_date_epoch" c_add_date_epoch(ctx: *EncodeCtx, tagged: int, v: long)
extern "sysl_qcbor_encode_add_days_epoch" c_add_days_epoch(ctx: *EncodeCtx, tagged: int, v: long)
